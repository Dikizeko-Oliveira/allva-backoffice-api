# Application
NODE_ENV="development"
PORT=8080
# Fecha o cadastro de contas novas nas tres portas de criacao: senha
# (POST /accounts), Google (POST /auth/google/register) e o primeiro login por
# Facebook (POST /auth/facebook), que cria a conta quando o e-mail e novo.
# Quem ja tem conta continua entrando normalmente. Aceita apenas 'true'/'false'.
REGISTRATION_DISABLED=false
# Base URL of the user-facing app. Single source of truth for every link the API
# puts in an email (welcome, verification, password reset, invitation, alert,
# daily summary) and for the Stripe checkout return URLs. Read through
# AppUrlService — there is no second variable for this.
FRONTEND_URL="http://localhost:3000"
# Comma-separated extra origins allowed by CORS, on top of FRONTEND_URL. Only
# enforced in production; outside it every origin is accepted.
CORS_ALLOWED_ORIGINS=
# Mount /docs, /docs-json and /scalar. Unset follows NODE_ENV (on outside
# production, off in production) — they are unauthenticated and expose the whole
# API surface. Set "true"/"false" to override.
DOCS_ENABLED=
INTEGRATION_TOKEN_ENCRYPTION_KEY="518df986-e3ba-411b-9c70-e97c9c2ba78a-ee2acf0da570"
ADS_SYNC_QUEUE_NAME=allva-ads-sync
ADS_SYNC_CRON=0 3 * * *
ADS_SYNC_LOOKBACK_DAYS=7
ADS_SYNC_MAX_LOOKBACK_DAYS=90
ADS_SYNC_COOLDOWN_SECONDS=60

# Google Ads (real OAuth + GAQL sync)
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REDIRECT_URI=http://localhost:3333/api/v1/integrations/google/callback
GOOGLE_ADS_SCOPES=https://www.googleapis.com/auth/adwords
# Set only when using a Google Ads MCC (manager account) as login customer
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Versão da Google Ads API. Mesma razão da Meta: expira no calendário do Google,
# que aposenta cada versão ~13 meses após lançá-la. O provider ficou em v17 (de
# meados de 2024) até A2-S8. v25 saiu em 22/07/2026; v24 é a escolha N-1.
GOOGLE_ADS_API_VERSION=v24

# TikTok Ads (real OAuth + report API)
TIKTOK_ADS_CLIENT_ID=
TIKTOK_ADS_CLIENT_SECRET=
TIKTOK_ADS_REDIRECT_URI=http://localhost:3333/api/v1/integrations/tiktok/callback
TIKTOK_ADS_SCOPES=
# Smart+ pelas rotas próprias (D24). Desligado até a validação contra conta real
# com `pnpm verify:tiktok-smart-plus -- --advertiser=<id> --compare`.
TIKTOK_SMART_PLUS_ENABLED=false

# Database
DATABASE_URL="postgresql://allva_user:allva_password@localhost:5432/allva_db?schema=public"

# Email — one of: console | smtp | brevo (set brevo for production)
EMAIL_PROVIDER=brevo
EMAIL_FROM=no-reply@allva.com.br
EMAIL_FROM_NAME=no-reply
BREVO_API_KEY=
# Destinatário exclusivo das mensagens do Drawer de suporte — nunca remetente.
# O remetente continua sendo EMAIL_FROM acima.
ALLVA_SUPPORT_EMAIL=suporte@allva.com.br
EMAIL_LOGO_URL=https://allva.com.br/assets/logos/large.png
EMAIL_LOGO_MARCA_URL=https://allva.com.br/assets/logos/logo-marca.svg
# Only read when EMAIL_PROVIDER=smtp.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Envelope sender used by the SMTP provider. Independent of EMAIL_FROM above:
# when empty it falls back to a hardcoded noreply@allva.app, not to EMAIL_FROM.
SMTP_FROM=

# Authentication
# JWT_SECRET_KEY is CRITICAL: boot fails without it, and it must be >= 32 chars.
JWT_SECRET_KEY="super-secret-long-random-string"
# Optional; defaults to 7d. See docs/env-secrets.md for the critical-vs-optional rule.
JWT_EXPIRES_IN="7d"


# Redis
REDIS_URL="redis://localhost:6379"

# Kill switches — both accept only the literal "true"/"false" and default to
# true. They exist so a bad rollout can be reverted without a code deploy.
# Progressive brute-force lockout (counters live in security_audit_logs).
SECURITY_BRUTE_FORCE_ENABLED=true
# Resolve entitlement from the organization subscription in addition to the
# personal one. The merge is strictly additive, so turning it off can only
# remove access that an organization membership was granting.
ORG_SCOPED_ENTITLEMENT=true

# Billing reconciliation worker (repeatable Bull job; also expires org trials).
# Not part of the env schema — read directly by BillingReconciliationScheduler.
BILLING_RECONCILIATION_DISABLED=false
BILLING_RECONCILIATION_INTERVAL_MS=300000

# Onde ESTA API é alcançável de fora. Usada só para o link de download dentro do
# e-mail de relatório: a rota valida o token e redireciona para a URL assinada.
# Sem ela, o e-mail aponta para o relatório no app (funciona, exige login).
# Não tem default de propósito — um "http://localhost:3333" mandaria e-mail de
# produção com link para a máquina de quem fez o deploy.
API_PUBLIC_URL=http://localhost:3333

# ─── STORAGE DE OBJETOS ───────────────────────────────────────────────────────
# Quem guarda upload de criativo, miniatura de vídeo e PDF de relatório.
# Aceita GCS (padrão) ou S3; caixa e espaço são normalizados, mas um valor que
# não seja nenhum dos dois derruba o boot em vez de cair no padrão em silêncio.
STORAGE_PROVIDER=GCS

# Google Cloud Storage — o provedor padrão.
# Só o bucket é indispensável: sem ele o provider recusa com
# STORAGE_NOT_CONFIGURED e a degradação é anunciada no boot (o processo sobe).
# A política do bucket é que torna o objeto legível; nenhum ACL é aplicado no
# upload, exatamente como no S3.
GCS_PROJECT_ID=
GCS_BUCKET=
# Credenciais OPCIONAIS por decisão. Sem nenhuma das opções abaixo, o SDK usa
# Application Default Credentials — a service account anexada à instância no
# Cloud Run/GKE, que é o modo recomendado pelo Google e o único que não coloca
# chave privada em variável de ambiente. Preencha só para rodar fora do Google.
#
# Opção A — par solto. A chave PEM é multilinha: mantenha as aspas e o \n
# literal (a barra invertida, não uma quebra de linha real).
GCS_CLIENT_EMAIL=
GCS_PRIVATE_KEY=
# Opção B — caminho ABSOLUTO para o JSON da service account. Vence a opção A se
# as duas estiverem presentes. Duas armadilhas, as duas verificadas por
# `pnpm storage:check`:
#   - "~" NÃO é expandido aqui (valor de .env é literal): use /Users/voce/...
#   - tem que ser chave de SERVICE ACCOUNT (type: "service_account"), não um
#     OAuth client ID (client_secret_....apps.googleusercontent.com.json) — o
#     segundo não tem private_key e não assina nada.
GCS_KEY_FILENAME=
# Domínio próprio/CDN na frente do bucket. Afeta só a URL de leitura; a URL
# assinada de escrita continua apontando para o host que assinou, porque CDN
# costuma servir apenas GET.
GCS_PUBLIC_BASE_URL=

# Amazon S3 — alternativa, ativada com STORAGE_PROVIDER=S3.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Creative video preview (ffmpeg first-frame extraction -> STORAGE_PROVIDER)
# Set to "false" to stop previews from being enqueued and make any already-queued
# job a no-op; creative assets then keep a null firstFrameUrl.
VIDEO_PREVIEW_ENABLED=true
# Optional. Defaults to the binary shipped by the ffmpeg-static package.
# Point it at a system ffmpeg when the bundled build cannot run on the host.
# Readiness is reported at boot and on GET /api/v1/health -> optional.videoPreview
# ("ok" | "disabled" | "unavailable"). It never returns 503: preview is accessory.
FFMPEG_PATH=

# CÂMBIO (A2-S1 — R-M / D19)
# Toda taxa é coletada CONTRA o pivô; qualquer par sai por taxa cruzada. Coletar
# par a par explodiria em N² chamadas e faria BRL->EUR divergir de EUR->BRL.
FX_PIVOT_CURRENCY=USD
# Nome do vendor, gravado em fx_rates.source e em cada linha monetária (M2).
FX_PROVIDER=none
# Sem base URL, o provedor se declara não configurado: a ingestão segue e as
# linhas ficam com normalizationPending=true, em vez de falhar a cada linha.
# Precisa expor histórico POR DATA (endpoint /timeframe) — só taxa spot torna M2
# inaplicável e faz o primeiro ingest inteiro entrar sem normalização.
FX_PROVIDER_BASE_URL=
FX_PROVIDER_API_KEY=
# 400 dias: cobre a retenção de 13 meses e a linhagem que a atravessa (D19/G9).
FX_BACKFILL_DAYS=400
# Moedas extras além das observadas em contas e organizações (lista separada por
# vírgula). Útil para pré-aquecer o histórico antes do primeiro onboarding.
FX_TRACKED_CURRENCIES=BRL,USD,EUR

# STRIPE
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# Google OAuth credentials
# Optional: absent disables Google sign-in (GOOGLE_SSO_NOT_CONFIGURED), password
# login keeps working. Reported at boot as degraded.
GOOGLE_CLIENT_ID=
# Optional for future authorization-code flow
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3333/api/v1/auth/google/callback

# Meta App Credentials
# Optional: absent disables both the Meta Ads integration and Facebook sign-in.
META_APP_ID=
META_APP_SECRET=
META_CALLBACK_URL=http://localhost:3333/api/v1/integrations/meta/callback
# Versão da Graph API usada em OAuth, leitura e (A2-S7) escrita.
# Cada versão tem prazo de validade publicado pela Meta: v19.0 saiu do ar em
# 21/05/2026, v25.0 vale até 29/07/2028. Subir de versão é trocar esta variável;
# antes disso, conferir o changelog da versão alvo.
META_API_VERSION=v25.0

# AI Providers
# Teto de uma tentativa; o orquestrador cuida de retry/fallback entre providers.
AI_REQUEST_TIMEOUT_MS=45000
# Tempo que um provider/modelo fica fora da rota após saturação ou rate limit.
# Um Retry-After enviado pelo provider tem precedência sobre este valor.
AI_PROVIDER_COOLDOWN_MS=30000

# Optional: the orchestrator owns fallback, so an absent key degrades AI analysis
# instead of failing the boot. With neither OPENAI nor ANTHROPIC set, AI requests fail.
OPENAI_API_KEY=
OPENAI_CAMPAIGN_ANALYSIS_MODEL=gpt-5.6-luna
OPENAI_FALLBACK_MODEL=gpt-5.4-mini

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_COPY_MODEL=claude-sonnet-5
ANTHROPIC_FALLBACK_MODEL=claude-haiku-4-5

# Escrita em plataforma (A2-S7)
# As duas trancas nascem fechadas: sem elas configuradas, nenhuma escrita real
# acontece. `DRY_RUN_ONLY` permanece `true` por duas semanas em produção depois
# do sprint (RP5), com o caminho inteiro sendo exercitado sem mover dinheiro.
PLATFORM_ACTIONS_ENABLED=false
PLATFORM_ACTIONS_DRY_RUN_ONLY=true
# Rajada por organização (C10), em escritas por minuto. Não é preferência do
# cliente: é limitador de blast radius de R1. O teto diário — esse sim
# configurável por organização em `organization_ads_settings.action_daily_cap` —
# responde "quanto"; este responde "a que velocidade".
PLATFORM_ACTIONS_ORG_RATE_LIMIT_PER_MINUTE=30
