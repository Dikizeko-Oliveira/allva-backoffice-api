NODE_ENV=development
PORT=8081

# Banco PRÓPRIO do backoffice (docker-compose, porta 5433) — nunca o allva_db do produto.
DATABASE_URL=postgresql://allva_backoffice_user:allva_backoffice_password@localhost:5433/allva_backoffice_db?schema=public

# De onde vêm identidade, permissões e dado de produto.
ALLVA_API_URL=http://localhost:8080

FRONTEND_URL=http://localhost:3001
CORS_ALLOWED_ORIGINS=
TRUSTED_PROXIES=
DOCS_ENABLED=true

# Validade da introspecção do operador em cache. Teto de 60000 (docs/backoffice-api.md §2).
OPERATOR_INTROSPECTION_CACHE_MS=60000
