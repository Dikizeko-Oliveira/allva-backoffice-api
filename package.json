{
  "name": "@allva/backoffice-api",
  "version": "0.1.0",
  "private": true,
  "module": "module",
  "packageManager": "pnpm@8.15.5",
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node dist/src/main",
    "start:dev": "nest start --watch",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:ci": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules REQUIRE_DATABASE=true jest --config jest.integration.config.js --runInBand --forceExit",
    "integrations:reencrypt-tokens": "ts-node -r tsconfig-paths/register scripts/reencrypt-integration-tokens.ts",
    "postinstall": "prisma generate",
    "dev:token": "ts-node -r tsconfig-paths/register scripts/dev-token.ts",
    "storage:check": "ts-node -r tsconfig-paths/register scripts/check-storage.ts",
    "fx:check": "ts-node -r tsconfig-paths/register scripts/check-fx-coverage.ts",
    "seed:plans": "ts-node -r tsconfig-paths/register scripts/seed-plans.ts",
    "seed:ads-v2": "ts-node -r tsconfig-paths/register scripts/seed-ads-v2.ts",
    "verify:tiktok-smart-plus": "ts-node -r tsconfig-paths/register scripts/verify-tiktok-smart-plus.ts",
    "dev:chain": "ts-node -r tsconfig-paths/register scripts/dev-run-chain.ts",
    "provision:organizations": "ts-node -r tsconfig-paths/register scripts/provision-organizations.ts",
    "dev:enterprise": "ts-node -r tsconfig-paths/register scripts/dev-enterprise-org.ts",
    "dev:operator": "ts-node -r tsconfig-paths/register scripts/dev-operator.ts",
    "bench:ads": "ts-node -r tsconfig-paths/register scripts/bench-ads-list.ts",
    "bench:ingest": "ts-node -r tsconfig-paths/register scripts/bench-ingest.ts",
    "bench:waste": "ts-node -r tsconfig-paths/register scripts/bench-waste-rollup.ts",
    "bench:write": "ts-node -r tsconfig-paths/register scripts/bench-write-path.ts",
    "ai:cost": "ts-node -r tsconfig-paths/register scripts/ai-cost-report.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.89.0",
    "@aws-sdk/client-s3": "3.983.0",
    "@aws-sdk/s3-request-presigner": "3.983.0",
    "@getbrevo/brevo": "5.0.4",
    "@google-cloud/storage": "8.0.1",
    "@nest-lab/throttler-storage-redis": "1.2.0",
    "@nestjs/bull": "11.0.4",
    "@nestjs/cli": "11.0.16",
    "@nestjs/common": "11.1.13",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.13",
    "@nestjs/event-emitter": "3.1.0",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.13",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "11.2.6",
    "@nestjs/throttler": "6.5.0",
    "@prisma/adapter-pg": "7.3.0",
    "@prisma/client": "7.3.0",
    "@types/nodemailer": "8.0.0",
    "argon2": "0.44.0",
    "bull": "4.16.5",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.3",
    "dotenv": "17.2.3",
    "ffmpeg-static": "5.3.0",
    "helmet": "8.2.0",
    "jose": "6.1.3",
    "nodemailer": "8.0.7",
    "openai": "6.17.0",
    "passport": "0.7.0",
    "passport-google-oauth20": "2.0.0",
    "pdfkit": "0.18.0",
    "pg": "8.18.0",
    "prisma": "7.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "stripe": "22.1.1",
    "swagger-ui-express": "5.0.1",
    "zod": "4.3.6",
    "zod-validation-error": "5.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.3",
    "@eslint/js": "9.39.2",
    "@nestjs/schematics": "11.0.9",
    "@nestjs/testing": "11.1.13",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/multer": "2.0.0",
    "@types/node": "25.2.0",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "8.16.0",
    "@types/supertest": "6.0.3",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "globals": "17.3.0",
    "jest": "29.7.0",
    "prettier": "3.8.1",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "ts-jest": "29.2.5",
    "ts-loader": "9.5.4",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.54.0"
  }
}
