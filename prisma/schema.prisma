generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                      String                    @id @default(uuid())
  name                    String
  email                   String                    @unique
  selectedPlanId          String?                   @map("selected_plan_id")
  stripeCustomerId        String?                   @unique @map("stripe_customer_id")
  cpf                     String?
  role                    ACCOUNT_ROLE_TYPE         @default(USER)
  phone                   String?
  address                 String?
  addressNumber           String?                   @map("address_number")
  addressComplement       String?                   @map("address_complement")
  addressCity             String?                   @map("address_city")
  avatarUrl               String?                   @map("avatar_url")
  passwordHash            String                    @map("password_hash")
  emailVerified           Boolean                   @default(false) @map("email_verified")
  emailVerifiedAt         DateTime?                 @map("email_verified_at")
  platformSuspendedAt     DateTime?                 @map("platform_suspended_at")
  platformSuspendedBy     String?                   @map("platform_suspended_by")
  platformSuspendedReason String?                   @map("platform_suspended_reason")
  createdAt               DateTime                  @default(now()) @map("created_at")
  /// Quando a conta foi anonimizada a pedido do titular.
  ///
  /// **Anonimização, e nao delete fisico.** Metade das FKs que apontam para
  /// `accounts` e RESTRICT e nunca some (preferencias, integracoes, vinculos de
  /// organizacao, tickets) - o delete fisico nao passava, e mesmo que passasse
  /// levaria junto registro de negocio que nao e do titular. Aqui o dado pessoal
  /// e apagado, a linha permanece para as FKs segurarem, e este campo e o que
  /// diz que ela nao representa mais uma pessoa.
  deletedAt               DateTime?                 @map("deleted_at")
  subscription            Subscription?
  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  integration             Integration[]
  preference              Preference?
  invoice                 Invoice[]
  payments                Payment[]
  billingCards            BillingCard[]
  /// Uma conta pode **possuir varias** desde o multi-organizacao. A posse
  /// tambem aparece como participacao OWNER em `organizationUsers`, que e o que
  /// o RBAC le — esta relacao so diz quem criou.
  ownedOrganizations      Organization[]
  organizationUsers       OrganizationUser[]
  providerIdentities      AccountProviderIdentity[]
  salesLeads              SalesLead[]
  contacts                Contact[]
  supportTickets          SupportTicket[]           @relation("SupportTicketAuthor")
  supportTicketsAssigned  SupportTicket[]           @relation("SupportTicketOperator")
  supportTicketMessages   SupportTicketMessage[]    @relation("SupportTicketMessageAuthor")

  @@map("accounts")
}

model AccountProviderIdentity {
  id              String   @id @default(uuid())
  accountId       String   @map("account_id")
  provider        String
  providerSubject String   @map("provider_subject")
  email           String?
  createdAt       DateTime @default(now()) @map("created_at")
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([accountId])
  @@map("account_provider_identities")
}

model SalesLead {
  id                        String          @id @default(uuid())
  accountId                 String?         @map("account_id")
  companyName               String          @map("company_name")
  workEmail                 String          @map("work_email")
  fullName                  String          @map("full_name")
  phone                     String?
  estimatedMonthlySpend     Decimal?        @map("estimated_monthly_spend") @db.Decimal(14, 2)
  teamSize                  Int?            @map("team_size")
  platforms                 Json?
  notes                     String?
  desiredPlan               String          @map("desired_plan")
  status                    SalesLeadStatus @default(NEW)
  source                    String?
  assignedTo                String?         @map("assigned_to")
  qualifiedAt               DateTime?       @map("qualified_at")
  closedWonAt               DateTime?       @map("closed_won_at")
  closedLostAt              DateTime?       @map("closed_lost_at")
  metadata                  Json?
  provisionedOrganizationId String?         @map("provisioned_organization_id")
  createdAt                 DateTime        @default(now()) @map("created_at")
  updatedAt                 DateTime        @updatedAt @map("updated_at")

  account Account? @relation(fields: [accountId], references: [id])

  contracts EnterpriseContract[]

  @@index([status])
  @@index([accountId])
  @@index([workEmail])
  @@index([assignedTo])
  @@map("sales_leads")
}

model Contact {
  id         String        @id @default(uuid())
  accountId  String?       @map("account_id")
  name       String
  email      String
  subject    String
  message    String
  company    String?
  status     ContactStatus @default(NEW)
  source     String?
  readAt     DateTime?     @map("read_at")
  repliedAt  DateTime?     @map("replied_at")
  archivedAt DateTime?     @map("archived_at")
  metadata   Json?
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  account Account? @relation(fields: [accountId], references: [id])

  @@index([status])
  @@index([accountId])
  @@index([email])
  @@map("contacts")
}

/// O chamado por trás do Drawer de suporte (`POST /api/v1/support/messages`).
///
/// Nasce sempre `OPEN` e sem `operatorId` — não existe atribuição automática
/// ainda, então o campo fica livre para um painel futuro preencher. `priority`
/// é derivada do entitlement `support-priority` no momento da criação (não
/// recalculada depois): é o mesmo veredito que o catálogo de planos já dá ao
/// Drawer, e recalcular a cada leitura faria um upgrade de plano mudar a
/// prioridade de chamados antigos que o time já triou.
model SupportTicket {
  id                        String                @id @default(uuid())
  code                      String                @unique
  accountId                 String                @map("account_id")
  organizationId            String                @map("organization_id")
  /// Nome e e-mail do autor no momento do envio — sobrevivem a uma troca de
  /// nome/e-mail na conta, mesmo raciocínio de `Contact.name`/`Contact.email`.
  authorName                String                @map("author_name")
  authorEmail               String                @map("author_email")
  /// Quem vai resolver o chamado. Opcional de propósito: não existe atribuição
  /// automática neste momento.
  operatorId                String?               @map("operator_id")
  subject                   String
  message                   String
  category                  SupportTicketCategory @default(GENERAL)
  priority                  SupportTicketPriority @default(MEDIUM)
  status                    SupportTicketStatus   @default(OPEN)
  /// Print opcional do problema, subido via `storagePort.upload()` — mesmo
  /// caminho do avatar de conta. Os quatro campos nascem e morrem juntos
  /// (todos `null` quando não há anexo); `attachmentStorageProvider` grava
  /// onde o arquivo está de fato, e não um literal, pelo mesmo motivo de
  /// `Report.storageProvider` — o valor de `STORAGE_PROVIDER` pode mudar
  /// depois de o chamado já existir.
  attachmentUrl             String?               @map("attachment_url")
  attachmentKey             String?               @map("attachment_key")
  attachmentStorageProvider String?               @map("attachment_storage_provider")
  attachmentFilename        String?               @map("attachment_filename")
  createdAt                 DateTime              @default(now()) @map("created_at")
  updatedAt                 DateTime              @updatedAt @map("updated_at")

  /// A ultima mensagem da conversa — do cliente ou do operador.
  ///
  /// Distinto de `updated_at`, e a distincao e a razao de existir: trocar o
  /// status ou atribuir um responsavel mexe em `updated_at` sem ninguem ter
  /// dito nada. A fila do backoffice ordena por "quem falou por ultimo", e com
  /// `updated_at` um chamado subiria para o topo por causa de uma atribuicao.
  lastMessageAt DateTime @default(now()) @map("last_message_at")

  /// Quando o chamado entrou em RESOLVED/CLOSED. Nulo enquanto esta aberto, e
  /// **limpo na reabertura** — um chamado que voltou a OPEN nao tem data de
  /// resolucao.
  ///
  /// Existe porque agora ha produtor: a troca de status pelo operador. Antes
  /// o tempo ate a resolucao era aproximado por `updated_at`, o que deixou de
  /// funcionar no instante em que uma mensagem passou a mexer nessa coluna.
  resolvedAt DateTime? @map("resolved_at")

  /// Quando o status mudou pela ultima vez. Nulo = nunca mudou desde a
  /// abertura. E o carimbo que o historico do chamado mostra — derivar de
  /// `updated_at` dataria a mudanca de status na hora da ultima mensagem.
  statusChangedAt DateTime? @map("status_changed_at")

  account      Account                @relation("SupportTicketAuthor", fields: [accountId], references: [id])
  organization Organization           @relation(fields: [organizationId], references: [id])
  operator     Account?               @relation("SupportTicketOperator", fields: [operatorId], references: [id])
  messages     SupportTicketMessage[]

  @@index([organizationId])
  @@index([accountId])
  @@index([status])
  /// O filtro "sem responsavel" e "os meus" da fila do backoffice.
  @@index([operatorId])
  /// A ordenacao da fila cross-org: quem falou por ultimo primeiro.
  @@index([lastMessageAt(sort: Desc)])
  /// A listagem da Central de suporte: escopo por organizacao, mais recente
  /// primeiro. O indice de `organization_id` sozinho entregava as linhas da
  /// organizacao e deixava o Postgres ordenar todas elas para devolver vinte.
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("support_tickets")
}

/// Uma mensagem da conversa de um chamado.
///
/// O chamado guardava **uma** mensagem (`subject` + `message`), e isso bastava
/// enquanto o suporte era um e-mail de mao unica. O painel de operador precisa
/// de ida e volta, e a nota interna precisa de um tipo que o cliente nunca ve.
///
/// A mensagem original do cliente vira a primeira linha desta tabela na
/// criacao do chamado — `support_tickets.message` continua existindo como o
/// corpo do pedido original, e nao e reescrito depois. Dois lugares para o
/// mesmo texto e deliberado: o primeiro e o assunto do e-mail que ja saiu, o
/// segundo e a conversa.
model SupportTicketMessage {
  id                        String                   @id @default(uuid())
  ticketId                  String                   @map("ticket_id")
  kind                      SupportTicketMessageKind
  /// Quem escreveu. Nulo so sobrevive a anonimizacao da conta do autor.
  authorId                  String?                  @map("author_id")
  /// Carimbo do nome no envio, pela mesma razao de `support_tickets.author_name`.
  authorName                String                   @map("author_name")
  body                      String
  /// Print opcional **desta** mensagem. Os quatro campos nascem e morrem
  /// juntos, com a mesma disciplina de `support_tickets.attachment_*`: ou o
  /// arquivo foi subido e todos vem preenchidos, ou nenhum foi.
  ///
  /// A URL gravada e a permanente do bucket, que e privado — quem le chama
  /// `StoragePortInterface.getReadUrl` para assinar na hora. Guardar a URL
  /// assinada envelheceria em dias.
  attachmentUrl             String?                  @map("attachment_url")
  attachmentKey             String?                  @map("attachment_key")
  attachmentStorageProvider String?                  @map("attachment_storage_provider")
  attachmentFilename        String?                  @map("attachment_filename")
  createdAt                 DateTime                 @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author Account?      @relation("SupportTicketMessageAuthor", fields: [authorId], references: [id])

  @@index([ticketId, createdAt])
  @@map("support_ticket_messages")
}

/// Quem falou.
///
/// `INTERNAL_NOTE` e o que o cliente **nao** ve: combinacao com o time, o que
/// ja foi tentado, o aviso de que o caso vai escalar. Sem um tipo proprio essa
/// anotacao so teria dois destinos — a caixa de e-mail do cliente ou um canal
/// paralelo, onde ela se perde do chamado que a originou.
///
/// O filtro e responsabilidade de quem apresenta: as rotas de cliente nunca
/// selecionam esta linha, e ha teste que o exige.
enum SupportTicketMessageKind {
  CUSTOMER
  OPERATOR
  INTERNAL_NOTE
}

enum SupportTicketCategory {
  GENERAL
  BILLING
  TECHNICAL
  ACCOUNT
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  accountId String    @map("account_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  account   Account   @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// Codigo de confirmacao de email — seis digitos, uso unico.
///
/// `token_hash` guarda `sha256("<account_id>:<codigo>")`, e **nao** tem indice
/// unico: o hash e escopado pela conta, entao duas contas nunca colidem, mas a
/// mesma conta pode sortear os mesmos seis digitos num reenvio — e a linha
/// anterior continua na tabela, marcada como usada. Com `@unique`, esse reenvio
/// de 1 em 10^6 viraria um 500.
model EmailVerificationToken {
  id        String    @id @default(uuid())
  accountId String    @map("account_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  /// Palpites errados neste codigo. Estourado o teto, o codigo morre e a conta
  /// precisa pedir outro — e um novo sorteio.
  attempts  Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")
  account   Account   @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model Session {
  id               String    @id @default(uuid())
  accountId        String    @map("account_id")
  refreshTokenHash String    @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at")
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  account          Account   @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([refreshTokenHash])
  @@map("sessions")
}

model Subscription {
  id                     String           @id @default(uuid())
  accountId              String           @unique @map("account_id")
  planId                 String           @map("plan_id")
  billingCardId          String?          @map("billing_card_id")
  billingStatus          BillingStatus    @map("billing_status")
  accessStatus           AccessStatus     @default(BLOCKED) @map("access_status")
  startedAt              DateTime         @map("started_at")
  expiresAt              DateTime         @map("expires_at")
  gracePeriodEndsAt      DateTime?        @map("grace_period_ends_at")
  automaticRenovation    Boolean          @default(true) @map("automatic_renovation")
  isAnnual               Boolean          @default(false) @map("is_annual")
  externalSubscriptionId String?          @unique @map("external_subscription_id")
  externalReference      String?          @unique @map("external_reference")
  authorizationUrl       String?          @map("authorization_url")
  nextBillingAt          DateTime?        @map("next_billing_at")
  canceledAt             DateTime?        @map("canceled_at")
  billingProvider        BillingProvider? @map("billing_provider")

  // Downgrade agendado (migração de billing para Stripe). Um downgrade só vale no
  // fim do período já pago, então o plano atual continua valendo em `planId` e o
  // destino fica aqui até o rollover aplicá-lo. Upgrade não usa isto: vale na hora.
  pendingPlanId          String?      @map("pending_plan_id")
  pendingPlanEffectiveAt DateTime?    @map("pending_plan_effective_at")
  createdAt              DateTime     @default(now()) @map("created_at")
  account                Account      @relation(fields: [accountId], references: [id])
  plan                   Plan         @relation(fields: [planId], references: [id])
  billingCard            BillingCard? @relation(fields: [billingCardId], references: [id])
  invoices               Invoice[]
  payments               Payment[]

  @@map("subscriptions")
}

model Invoice {
  id                String          @id @default(uuid())
  /// Quem recebe a cobrança. Na fatura de contrato é o titular da organização
  /// — a empresa é a devedora, mas cobrança chega a uma pessoa.
  accountId         String          @map("account_id")
  /// Nulo na fatura de contrato: o Enterprise não tem assinatura de conta. A
  /// cobrança dele nasce do acordo, não de um checkout.
  subscriptionId    String?         @map("subscription_id")
  /// O contrato que originou a fatura, quando ela vem de um.
  ///
  /// A organização **não** é denormalizada aqui: alcança-se pelo contrato, e
  /// uma segunda coluna de tenancy nullable divergiria dele na primeira vez que
  /// alguém corrigisse um sem o outro.
  contractId        String?         @map("contract_id")
  number            String          @unique
  planId            String          @map("plan_id")
  provider          BillingProvider
  status            InvoiceStatus   @default(PENDING)
  amount            Decimal         @db.Decimal(12, 2)
  currency          String          @default("BRL")
  periodStart       DateTime        @map("period_start")
  periodEnd         DateTime        @map("period_end")
  dueAt             DateTime?       @map("due_at")
  externalReference String?         @map("external_reference")
  externalInvoiceId String?         @unique @map("external_invoice_id")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  createdAt         DateTime        @default(now()) @map("created_at")

  plan         Plan                @relation(fields: [planId], references: [id])
  account      Account             @relation(fields: [accountId], references: [id])
  subscription Subscription?       @relation(fields: [subscriptionId], references: [id])
  contract     EnterpriseContract? @relation(fields: [contractId], references: [id])
  payments     Payment[]

  @@map("invoices")
}

model Payment {
  id                String             @id @default(uuid())
  accountId         String             @map("account_id")
  subscriptionId    String             @map("subscription_id")
  invoiceId         String             @map("invoice_id")
  provider          BillingProvider
  status            PaymentStatus      @default(PENDING)
  paymentMethod     PaymentMethodType? @map("payment_method")
  amount            Decimal            @db.Decimal(12, 2)
  currency          String             @default("BRL")
  externalReference String             @unique @map("external_reference")
  externalPaymentId String?            @unique @map("external_payment_id")
  statusDetail      String?            @map("status_detail")
  metadata          Json?
  rawResponse       Json?              @map("raw_response")
  paidAt            DateTime?          @map("paid_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  account      Account      @relation(fields: [accountId], references: [id])
  subscription Subscription @relation(fields: [subscriptionId], references: [id])
  invoice      Invoice      @relation(fields: [invoiceId], references: [id])

  @@index([accountId])
  @@index([subscriptionId])
  @@index([invoiceId])
  @@map("payments")
}

model BillingCard {
  id                 String             @id @default(uuid())
  accountId          String             @map("account_id")
  provider           BillingProvider
  externalCustomerId String             @map("external_customer_id")
  externalCardId     String             @map("external_card_id")
  brand              String?
  paymentMethod      PaymentMethodType? @map("payment_method")
  firstSixDigits     String?            @map("first_six_digits")
  lastFourDigits     String             @map("last_four_digits")
  expirationMonth    Int                @map("expiration_month")
  expirationYear     Int                @map("expiration_year")
  issuerName         String?            @map("issuer_name")
  cardholderName     String?            @map("cardholder_name")
  status             BillingCardStatus  @default(ACTIVE)
  isDefault          Boolean            @default(false) @map("is_default")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  account       Account        @relation(fields: [accountId], references: [id])
  subscriptions Subscription[]

  @@unique([provider, externalCardId])
  @@index([accountId, provider])
  @@map("billing_cards")
}

model BillingWebhookEvent {
  id              String          @id @default(uuid())
  provider        BillingProvider
  eventKey        String          @unique @map("event_key")
  topic           String
  action          String?
  externalEventId String?         @map("external_event_id")
  resourceId      String          @map("resource_id")
  payload         Json
  processedAt     DateTime?       @map("processed_at")
  createdAt       DateTime        @default(now()) @map("created_at")

  @@index([provider, topic, resourceId])
  @@map("billing_webhook_events")
}

model Preference {
  id                      String    @id @default(uuid())
  accountId               String    @unique @map("account_id")
  notificationByEmail     Boolean   @default(true) @map("notification_by_email")
  dailyResume             Boolean   @default(false) @map("daily_resume")
  promotionNotifications  Boolean   @default(true) @map("promotion_notifications")
  productNewsNotification Boolean   @default(true) @map("product_news_notification")
  // Sprint 6 / M-2. Defaults on: an alert reports money being wasted right now, so
  // the useful default is to be told. `notificationByEmail` still overrides it.
  alertNotifications      Boolean   @default(true) @map("alert_notifications")
  createdAt               DateTime  @default(now()) @map("created_at")
  /// Quando um humano salvou esta tela pela primeira vez.
  ///
  /// `null` = a linha existe porque **toda conta nasce com uma**
  /// (`AccountOnboardingService.ensurePreference`, sem a qual o e-mail com
  /// gate de preferencia nao alcanca ninguem), e nao porque alguem escolheu
  /// alguma coisa. A existencia da linha, portanto, nao responde "ja
  /// configurou?" — responde "a conta existe".
  ///
  /// Carimbo, e nao comparacao com os defaults, pela mesma razao de
  /// `organizations.name_confirmed_at`: quem abre a tela e mantem tudo como
  /// esta **configurou**, e uma heuristica por diferenca o perguntaria para
  /// sempre. Um ajuste nos defaults do schema tambem viraria mudanca de regra
  /// silenciosa.
  reviewedAt              DateTime? @map("reviewed_at")

  account Account @relation(fields: [accountId], references: [id])

  @@map("preferences")
}

model Plan {
  id                               String                     @id @default(uuid())
  type                             PlanType                   @unique
  name                             String
  /// Janela do teste gratuito. O plano FREE **é** o teste: quando ela fecha nao
  /// existe camada gratuita para onde cair, e a conta precisa contratar um plano
  /// pago (aplicado em `SubscriptionContextResolver`).
  trialDays                        Int?                       @map("trial_days")
  amount                           Float?
  /// Preco anual cheio, na mesma unidade de `amount`. Nulo = o plano nao e
  /// vendido no ciclo anual (FREE) ou o preco e negociado (ENTERPRISE).
  amountAnnual                     Float?                     @map("amount_annual")
  stripePriceId                    String?                    @unique @map("stripe_price_id")
  /// O ciclo anual precisa do seu proprio price na Stripe: `stripePriceId`
  /// sozinho so consegue expressar um dos dois ciclos.
  stripePriceIdAnnual              String?                    @unique @map("stripe_price_id_annual")
  createdAt                        DateTime                   @default(now()) @map("created_at")
  features                         PlanFeature[]
  subscriptions                    Subscription[]
  invoices                         Invoice[]
  organizationSubscriptions        OrganizationSubscription[]
  pendingOrganizationSubscriptions OrganizationSubscription[] @relation("OrganizationSubscriptionPendingPlan")
  enterpriseContracts              EnterpriseContract[]

  @@map("plans")
}

/// O plano **da organizacao** — a fonte que TODAS as guardas de plano leem.
///
/// `planId` era escrito uma unica vez, no provisionamento, e nunca mais: subir
/// ou descer de plano mexia so em `subscriptions` (escopo de conta). O efeito era
/// simetrico e igualmente errado nos dois sentidos — quem contratava o
/// Profissional continuava com os limites do Individual, e quem descia continuava
/// com os do Profissional. Custo sem receita de um lado, entrega sem cobranca do
/// outro.
model OrganizationSubscription {
  id             String        @id @default(uuid())
  organizationId String        @unique @map("organization_id")
  planId         String        @map("plan_id")
  status         BillingStatus @default(TRIALING)

  /// Queda de plano agendada. O downgrade so vale no fim do periodo pago — o
  /// cliente comprou o mes —, entao `planId` fica onde esta e o destino espera
  /// aqui. **Upgrade nao usa isto**: vale na hora, e limpa o que estiver pendente.
  ///
  /// A resolucao e por LEITURA (`pendingPlanEffectiveAt <= now`), como a
  /// expiracao do teste e o congelamento de conta: quem aplicaria a virada e o
  /// webhook da Stripe, e um limite que dependesse dele nao valeria se ele
  /// falhasse — que e exatamente o cenario em que o cliente continua usando o
  /// plano caro de graca.
  pendingPlanId          String?   @map("pending_plan_id")
  pendingPlanEffectiveAt DateTime? @map("pending_plan_effective_at")

  trialStartedAt DateTime  @map("trial_started_at")
  trialEndsAt    DateTime? @map("trial_ends_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  plan         Plan         @relation(fields: [planId], references: [id])
  pendingPlan  Plan?        @relation("OrganizationSubscriptionPendingPlan", fields: [pendingPlanId], references: [id])

  @@index([planId])
  @@map("organization_subscriptions")
}

