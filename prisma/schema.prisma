  id                String   @id @default(uuid())
  salesLeadId       String   @map("sales_lead_id")
  terms             Json
  status            String   @default("DRAFT")
  draftDocumentKey  String?  @map("draft_document_key")
  signatureProvider String?  @map("signature_provider")
  envelopeId        String?  @map("envelope_id")
  envelopeStatus    String?  @map("envelope_status")
  contractId        String?  @map("contract_id")
  createdBy         String   @map("created_by")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([salesLeadId])
  @@index([status])
  @@map("contract_drafts")
}

model BackofficeAuditLog {
  id          String   @id @default(uuid())
  actorId     String   @map("actor_id")
  action      String
  subjectType String   @map("subject_type")
  subjectId   String   @map("subject_id")
  before      Json?
  after       Json?
  reason      String?
  ip          String?
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@index([subjectType, subjectId])
  @@index([action, createdAt])
  @@map("backoffice_audit_logs")
}

/// Idempotência de janela (§8.8) e coordenação distribuída dos jobs. Sem esta
/// tabela, "o cron verifica a chave de idempotência da janela" não tem onde
/// verificar: cada janela roda duas vezes, dobrando custo de LLM (P9).
model JobRun {
  id        String       @id @default(uuid())
  jobName   String       @map("job_name")
  scopeType JobScopeType @map("scope_type")
  scopeId   String       @map("scope_id")
  /// "2026-08-01T14" | "2026-08-01"
  windowKey String       @map("window_key")

  status     JobRunStatus @default(RUNNING)
  /// Vocabulário fechado: SKIPPED sem razão é tão opaco quanto não ter status.
  skipReason String?      @map("skip_reason")
  /// Token de cerca (fencing token), monotônico por linha. É o que impede um
  /// worker zumbi de marcar como SUCCEEDED uma janela que não fez — e SUCCEEDED
  /// nunca reexecuta, então o buraco seria permanente.
  attempt    Int          @default(1)

  startedAt      DateTime  @default(now()) @map("started_at")
  leaseExpiresAt DateTime  @map("lease_expires_at")
  finishedAt     DateTime? @map("finished_at")
  durationMs     Int?      @map("duration_ms")

  processedItems  Int @default(0) @map("processed_items")
  successfulItems Int @default(0) @map("successful_items")
  failedItems     Int @default(0) @map("failed_items")

  correlationId String? @map("correlation_id")
  result        Json?
  errorMessage  String? @map("error_message")

  @@unique([jobName, scopeType, scopeId, windowKey])
  @@index([jobName, startedAt])
  @@index([status, leaseExpiresAt])
  @@map("job_runs")
}

enum JobRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

enum JobScopeType {
  AD_ACCOUNT
  ORGANIZATION
  INTEGRATION
  GLOBAL
}

enum OrgCurrencyState {
  STABLE
  RECOMPUTING_CURRENCY
}

/// Os quatro tipos do v1 mais os onze da v2.0. `SYNC_QUARANTINE` e
/// `AD_ARCHIVE_SUPPRESSED` são sobre a CONTA — é por eles que `Alert` precisa de
/// seis sujeitos e não cinco.
enum AlertType {
  WASTE_DETECTED
  RECOMMENDATION_GENERATED
  BUDGET_ALERT
  SYSTEM
  AD_SCORE_DROPPED
  AD_DRIFT_DETECTED
  ACTION_FAILED
  ACTION_VERIFIED
  INTEGRATION_DISCONNECTED
  AD_ARCHIVE_SUPPRESSED
  SYNC_QUARANTINE
  UNVERIFIED_WRITE
  DENORMALIZATION_DRIFT
  AI_BUDGET_EXCEEDED
  PARTITION_MARGIN_LOW
  ACTION_PARTIALLY_COMPLETED
}
