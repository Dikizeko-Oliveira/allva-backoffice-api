generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// Banco PRÓPRIO do backoffice-api — nunca o `allva_db` do produto. Os dois têm
// históricos de migração independentes, e dividir a `_prisma_migrations` faria
// o `migrate dev` de um repositório pedir reset por causa do outro.
//
// Toda referência ao produto (ticket, operador, lead, contrato) é id opaco,
// sem FK: o dado mora no `allva-api` e chega por HTTP.
datasource db {
  provider = "postgresql"
}

model TicketAssignmentEvent {
  id             String   @id @default(uuid())
  ticketId       String   @map("ticket_id")
  fromOperatorId String?  @map("from_operator_id")
  toOperatorId   String?  @map("to_operator_id")
  actorId        String   @map("actor_id")
  reason         String?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([ticketId, createdAt])
  @@index([actorId])
  @@map("ticket_assignment_events")
}

model SlaPolicy {
  id                   String   @id @default(uuid())
  priority             String
  category             String?
  firstResponseMinutes Int      @map("first_response_minutes")
  resolutionMinutes    Int      @map("resolution_minutes")
  businessHours        Boolean  @default(false) @map("business_hours")
  active               Boolean  @default(true)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  // Uma política ATIVA por escopo (prioridade + categoria, com NULL contando
  // como "toda categoria"). O Prisma não expressa índice parcial nem sobre
  // expressão, então `sla_policies_one_active_per_scope` vive só na migration.
  // Um `@@unique([priority, category, active])` aqui deixaria passar duas
  // genéricas ativas (NULL é distinto de NULL) e barraria duas inativas.
  @@index([priority, active])
  @@map("sla_policies")
}

model TicketSlaSnapshot {
  ticketId                String    @id @map("ticket_id")
  priority                String
  category                String?
  status                  String
  assigneeId              String?   @map("assignee_id")
  /// Quando o chamado foi aberto no produto — não quando esta linha nasceu.
  openedAt                DateTime  @map("opened_at")
  lastMessageAt           DateTime  @map("last_message_at")
  lastMessageKind         String?   @map("last_message_kind")
  dueFirstResponseAt      DateTime? @map("due_first_response_at")
  dueResolutionAt         DateTime? @map("due_resolution_at")
  firstOperatorReplyAt    DateTime? @map("first_operator_reply_at")
  resolvedAt              DateTime? @map("resolved_at")
  escalatedAt             DateTime? @map("escalated_at")
  escalatedTo             String?   @map("escalated_to")
  escalatedAcknowledgedAt DateTime? @map("escalated_acknowledged_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@index([assigneeId])
  @@index([openedAt])
  @@index([dueFirstResponseAt])
  @@index([dueResolutionAt])
  @@map("ticket_sla_snapshots")
}

model InternalNote {
  id                   String    @id @default(uuid())
  subjectType          String    @map("subject_type")
  subjectId            String    @map("subject_id")
  authorId             String    @map("author_id")
  body                 String
  pinned               Boolean   @default(false)
  visibilityPermission String?   @map("visibility_permission")
  createdAt            DateTime  @default(now()) @map("created_at")
  editedAt             DateTime? @map("edited_at")
  deletedAt            DateTime? @map("deleted_at")

  @@index([subjectType, subjectId, createdAt])
  @@index([authorId])
  @@map("internal_notes")
}

model OperatorPreference {
  operatorId       String   @id @map("operator_id")
  lastWorkspace    String?  @map("last_workspace")
  sidebarCollapsed Boolean  @default(false) @map("sidebar_collapsed")
  density          String   @default("comfortable")
  timezone         String?
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("operator_preferences")
}

model SavedView {
  id         String   @id @default(uuid())
  operatorId String   @map("operator_id")
  screen     String
  name       String
  filters    Json     @default("{}")
  columns    Json     @default("[]")
  sort       Json?
  isDefault  Boolean  @default(false) @map("is_default")
  shared     Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([operatorId, screen])
  @@index([screen, shared])
  @@map("saved_views")
}

model AlertRule {
  id                 String   @id @default(uuid())
  source             String
  threshold          String
  channel            String
  target             String
  requiredPermission String   @map("required_permission")
  quietHours         Json?    @map("quiet_hours")
  active             Boolean  @default(true)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  events AlertEvent[]

  @@index([source, active])
  @@map("alert_rules")
}

model AlertEvent {
  id             String    @id @default(uuid())
  ruleId         String    @map("rule_id")
  source         String
  severity       String
  payload        Json?
  acknowledgedBy String?   @map("acknowledged_by")
  acknowledgedAt DateTime? @map("acknowledged_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  rule AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId, acknowledgedAt])
  @@index([source, createdAt])
  @@map("alert_events")
}

model ContractDraft {
  id                String   @id @default(uuid())
  salesLeadId       String   @map("sales_lead_id")
  terms             Json
  status            String   @default("DRAFT")
  draftDocumentKey  String?  @map("draft_document_key")
  signatureProvider String?  @map("signature_provider")
  envelopeId        String?  @map("envelope_id")
  envelopeStatus    String?  @map("envelope_status")
  contractId        String?  @map("contract_id")
  createdBy         String   @map("created_by")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([salesLeadId])
  @@index([status])
  @@map("contract_drafts")
}

model BackofficeAuditLog {
  id          String   @id @default(uuid())
  actorId     String   @map("actor_id")
  action      String
  subjectType String   @map("subject_type")
  subjectId   String   @map("subject_id")
  before      Json?
  after       Json?
  reason      String?
  ip          String?
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@index([subjectType, subjectId])
  @@index([action, createdAt])
  @@map("backoffice_audit_logs")
}
