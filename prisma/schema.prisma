  @@index([email])
  @@map("organization_invitations")
}

model Integration {
  id             String            @id @default(uuid())
  name           String?
  accountId      String            @map("account_id")
  /// NOT NULL desde A2-S1 (D6). Sem organização na credencial, o REBIND de P10
