/// Papel de **plataforma** — quem opera a Allva —, e não papel de cliente.
///
/// Permissão dentro de uma organização mora em `OrganizationUserRole`. Este enum
/// já teve `ADMIN` e `MEMBER`, homônimos daqueles, com default `ADMIN`: todo
/// cliente parecia administrador aqui. Toda conta que não opera a plataforma é
/// `USER`.
/// Papel de **plataforma** — quem opera a Allva, nao quem a usa.
///
/// `USER` e toda conta de cliente. Os outros cinco sao faixas paralelas, nao
/// degraus: o que cada um pode esta em `accounts/domain/platform-rbac.ts`, e
/// `platform-rbac.spec.ts` recusa um valor aqui sem entrada correspondente la.
/// Um papel novo neste enum sem linha na matriz nasce **sem permissao
/// nenhuma** (a matriz fecha na duvida) — e o teste existe para isso ser pego
/// antes do deploy, e nao descoberto como "o papel novo nao consegue nada".
enum ACCOUNT_ROLE_TYPE {
  USER
  ALLVA_ADMIN
  ALLVA_OPERATOR
  ALLVA_SUPPORT
  ALLVA_FINANCE
  ALLVA_SALES
}

enum ProviderType {
  GOOGLE
  META
  TIKTOK
}

enum OrganizationUserStatus {
  ACTIVE
  INVITED
  BLOCKED
  REMOVED
}

/// O acordo comercial de um cliente Enterprise — a fonte da verdade sobre o que
/// foi combinado.
///
/// **Contrato não é assinatura.** `OrganizationSubscription` responde "qual é o
/// acesso desta organização agora"; este modelo responde "o que a Allva e o
/// cliente combinaram". Ciclos de vida diferentes: a assinatura vira ACTIVE na
/// ativação e fica, enquanto o contrato tem vigência, aditivo, renovação e
/// encerramento.
///
/// **A vigência mora aqui, e só aqui.** A linha em `organization_subscriptions`
/// não guarda cópia de `endsAt`: o resolver de entitlement lê o contrato em
/// tempo de leitura, do mesmo jeito que já trata um teste vencido sem esperar
/// job. Duplicar a data criaria uma segunda casa que envelhece na primeira
/// renegociação que esquecer de atualizá-la.
model EnterpriseContract {
  id             String  @id @default(uuid())
  /// ENT-2026-0012 — o número que aparece no documento assinado.
  contractNumber String  @unique @map("contract_number")
  /// Todo contrato parte de um lead, mesmo quando o operador o cadastrou: é o
  /// que dá ao comercial a rastreabilidade de onde cada negócio veio.
  salesLeadId    String  @map("sales_lead_id")
  /// Preenchido na **ativação**. Nulo antes dela — o contrato existe assinado
  /// antes de haver organização provisionada.
  ///
  /// Sem `@unique`: a renovação gera um contrato novo para a mesma
  /// organização, e a cadeia é o histórico comercial do cliente. "No máximo um
  /// ativo por organização" é invariante de negócio, garantida na ativação.
  organizationId String? @map("organization_id")
  /// O plano do catálogo que ancora o entitlement. O contrato ajusta os tetos
  /// por cima dele; as features vêm da régua do plano.
  planId         String  @map("plan_id")

  status   ContractStatus @default(SIGNED)
  /// A vigência negociada. `endsAt` é o que fecha o acesso quando chega.
  startsAt DateTime       @map("starts_at")
  endsAt   DateTime       @map("ends_at")

  billingInterval ContractBillingInterval @map("billing_interval")
  billingAmount   Decimal                 @map("billing_amount") @db.Decimal(14, 2)
  /// Cobrança única de implantação, quando vendida junto. Modelo "setup +
  /// recorrência": entra na primeira fatura e não se repete.
  setupFeeAmount  Decimal?                @map("setup_fee_amount") @db.Decimal(14, 2)
  currency        String                  @default("BRL")
  paymentTerms    ContractPaymentTerms    @map("payment_terms")
  paymentMethod   ContractPaymentMethod   @map("payment_method")

  /// Abre o acesso na assinatura, sem esperar a fatura fechar.
  ///
  /// Padrão verdadeiro porque é como B2B funciona: empresa grande paga por
  /// boleto em 30 dias, e travar o cliente até a compensação transformaria a
  /// condição de pagamento negociada em punição. Falso quando a negociação
  /// exigir pré-pagamento — cliente novo sem histórico, por exemplo.
  activateOnSignature Boolean @default(true) @map("activate_on_signature")
  /// Dias de atraso tolerados antes de a inadimplência fechar o acesso.
  ///
  /// Uma semana, e não o `GRACE_PERIOD_DAYS = 1` do self-serve: aquele existe
  /// para a Stripe reprocessar um cartão recusado, e um dia basta. Aqui o
  /// atraso costuma ser boleto perdido no financeiro do cliente, que leva mais
  /// que isso para aparecer. Negociável por contrato — o padrão só responde
  /// pelo silêncio.
  gracePeriodDays     Int     @default(7) @map("grace_period_days")
  autoRenew           Boolean @default(false) @map("auto_renew")

  /// Os tetos negociados. Nulo herda o teto do plano — nunca significa
  /// "ilimitado", pela mesma regra de `organization_quotas`, para onde estes
  /// valores descem na ativação.
  maxSeats         Int? @map("max_seats")
  maxAdAccounts    Int? @map("max_ad_accounts")
  maxMonitoredAds  Int? @map("max_monitored_ads")
  maxOrganizations Int? @map("max_organizations")

  /// O teto diário de gasto com IA que o contrato negociou, em moeda-base.
  ///
  /// Nulo é **sem teto**, e é o certo para um contrato ainda não precificado: o
  /// default de R$ 50/dia de `organization_ads_settings` foi calibrado para o
  /// maior plano de autoatendimento e cortaria uma entrega de 40.000 anúncios
  /// em ~31 mil narrativas na primeira madrugada.
  llmDailyBudgetBase Decimal? @map("llm_daily_budget_base") @db.Decimal(14, 4)

  signedAt          DateTime                  @map("signed_at")
  signedDocumentUrl String?                   @map("signed_document_url")
  activatedAt       DateTime?                 @map("activated_at")
  canceledAt        DateTime?                 @map("canceled_at")
  suspendedAt       DateTime?                 @map("suspended_at")
  /// Quem suspendeu decide quem pode reativar.
  ///
  /// Uma suspensão por inadimplência se desfaz sozinha quando a fatura é
  /// baixada; uma suspensão decidida pelo operador — quebra de contrato,
  /// fraude — não pode ser desfeita por um pagamento. Sem esta distinção, o
  /// job de cobrança reabriria uma conta que alguém fechou de propósito.
  suspendedReason   ContractSuspensionReason? @map("suspended_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// O contrato que este renovou, quando é uma renovação.
  ///
  /// A cadeia é o histórico comercial do cliente: quem chega pelo contrato
  /// atual consegue andar para trás e ver desde quando ele é cliente, e por
  /// quanto pagava antes.
  renewedFromId String? @unique @map("renewed_from_id")

  invoices     Invoice[]
  amendments   ContractAmendment[]
  salesLead    SalesLead           @relation(fields: [salesLeadId], references: [id])
  organization Organization?       @relation(fields: [organizationId], references: [id])
  plan         Plan                @relation(fields: [planId], references: [id])
  renewedFrom  EnterpriseContract? @relation("ContractRenewal", fields: [renewedFromId], references: [id])
  renewedInto  EnterpriseContract? @relation("ContractRenewal")

  @@index([status])
  @@index([organizationId])
  @@index([salesLeadId])
  @@index([endsAt])
  @@map("enterprise_contracts")
}

/// Uma alteração negociada no meio da vigência.
///
/// O que separa aditivo de correção: antes da ativação, um erro de digitação
/// se conserta editando o contrato. Depois dela o cliente já está usando o que
/// foi provisionado, e mudar em silêncio apagaria o que ele contratou — o
/// aditivo é o registro de que a mudança foi acordada, quando passa a valer e
/// o que havia antes.
model ContractAmendment {
  id             String @id @default(uuid())
  contractId     String @map("contract_id")
  /// Sempre presente: só se adita um contrato já ativado, e ativar é o que
  /// provisiona a organização. É por isso que aqui não cabe a exceção de
  /// nulidade que o contrato tem.
  organizationId String @map("organization_id")
  /// ENT-2026-0012/A1 — como o aditivo é citado no documento.
  number         String @unique

  /// Quando a mudança passa a valer.
  ///
  /// Datado, e não imediato, porque é assim que se negocia: "a partir de
  /// janeiro passam a ser 250 assentos". Aplicar na hora cobraria o cliente
  /// por um mês que ele não contratou.
  effectiveAt DateTime  @map("effective_at")
  /// Preenchido quando a mudança foi de fato escrita na cota. Nulo é um
  /// aditivo assinado que ainda não chegou a data.
  appliedAt   DateTime? @map("applied_at")
  reason      String

  /// Os novos valores. Nulo significa **inalterado** nesta dimensão — e não
  /// "herda o plano", que é o que nulo quer dizer no contrato.
  billingAmount      Decimal? @map("billing_amount") @db.Decimal(14, 2)
  maxSeats           Int?     @map("max_seats")
  maxAdAccounts      Int?     @map("max_ad_accounts")
  maxMonitoredAds    Int?     @map("max_monitored_ads")
  maxOrganizations   Int?     @map("max_organizations")
  /// O teto diário de gasto com IA que o aditivo passa a valer.
  llmDailyBudgetBase Decimal? @map("llm_daily_budget_base") @db.Decimal(14, 4)

  /// O que havia antes, carimbado no momento da aplicação.
  ///
  /// Sem isto, aplicar o aditivo sobrescreveria o contrato e o "de 150 para
  /// 250" viraria só "250" — o comercial perderia justamente a informação que
  /// justifica a cobrança nova.
  previousBillingAmount      Decimal? @map("previous_billing_amount") @db.Decimal(14, 2)
  previousMaxSeats           Int?     @map("previous_max_seats")
  previousMaxAdAccounts      Int?     @map("previous_max_ad_accounts")
  previousMaxMonitoredAds    Int?     @map("previous_max_monitored_ads")
  previousMaxOrganizations   Int?     @map("previous_max_organizations")
  /// O teto de gasto anterior, para a trilha dizer o que mudou.
  previousLlmDailyBudgetBase Decimal? @map("previous_llm_daily_budget_base") @db.Decimal(14, 4)

  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  contract     EnterpriseContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  organization Organization       @relation(fields: [organizationId], references: [id])

  @@index([contractId])
  @@index([organizationId])
  /// O job diário varre por aqui: aditivos vencidos e ainda não aplicados.
  @@index([appliedAt, effectiveAt])
  @@map("contract_amendments")
}

enum ContractStatus {
  /// Documento assinado, organização ainda não provisionada.
  SIGNED
  /// Assinado, mas o acesso aguarda a primeira baixa
  /// (`activateOnSignature: false`).
  PENDING_ACTIVATION
  ACTIVE
  /// Acesso fechado por inadimplência ou decisão do operador — o contrato
  /// segue existindo, e a reativação é o caminho de volta.
  SUSPENDED
  CANCELED
  /// A vigência terminou. Renovar gera um contrato novo.
  EXPIRED
  /// Substituído pelo contrato seguinte, que preserva a cadeia.
  RENEWED
}

enum ContractBillingInterval {
  ANNUAL
  MONTHLY
