/// A geração de copy como **pedido**, com a procedência inteira (P7).
///
/// A formulação de P4 que vale aqui é própria da feature, e está escrita em
/// `creative-lab/domain/creative-suggestions.ts`: **o determinístico decide o
/// que mudar e por quê; o LLM escreve as palavras**. Esta tabela guarda as duas
/// metades — o contexto e a sugestão que originaram o pedido, e o texto que
/// saiu dele — porque separá-las tornaria irrespondível a única pergunta que
/// justifica salvar geração: *qual sugestão de fato melhorou o desempenho?*
model CopyGeneration {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  accountId      String @map("account_id")

  /// **Nunca nulo, inclusive em FROM_BRIEF.**
  ///
  /// Uma geração sem anúncio não tem score que justifique o pedido, não tem
  /// `REPLACE_COPY` onde aterrissar e não tem linhagem por onde ser medida — e é
  /// a única forma da feature que chega perto de originar mídia (P1). "Começar
  /// do zero" continua existindo como experiência: é ignorar o texto atual, não
  /// dispensar o anúncio.
  adId       String  @map("ad_id")
  creativeId String? @map("creative_id")
  /// A análise que produziu a sugestão — a ponte, quando o pedido veio dela.
  analysisId String? @map("analysis_id")
  /// O score vigente no instante do pedido. Reprodutibilidade, como em
  /// `CreativeAnalysis.adScoreId`.
  adScoreId  String? @map("ad_score_id")

  source CopyGenerationSource
  status CopyGenerationStatus

  /// Snapshot versionado do que entrou no prompt. Schema Zod em `domain/`.
  context Json

  /// Dígito do contexto: é o que permite reusar a última geração quando nada
  /// mudou, e o que cruza esta linha com a de `AIDecisionLog`.
  ///
  /// Não é P9: geração é disparada por pessoa, e regerar é legítimo. O reuso
  /// aqui é conveniência com escape explícito, não proibição de recomputo.
  inputDigest String @map("input_digest")

  engineVersion String  @map("engine_version")
  promptVersion String  @map("prompt_version")
  aiProvider    String? @map("ai_provider")
  aiModel       String? @map("ai_model")

  /// Por que não saiu variante nenhuma. `null` quando saiu.
  failureReason String? @map("failure_reason")

  createdAt DateTime @default(now()) @map("created_at")

  /// D5 — o instante a partir do qual este conteúdo se torna **elegível** a
  /// expurgo. Carimbado na criação com a política vigente naquele momento:
  /// mudar o prazo depois não pode apagar retroativamente o que foi gerado sob
  /// a promessa anterior.
  ///
  /// Elegível não é agendado. A poda só alcança organizações fora de dia com a
  /// cobrança — enquanto o cliente está ativo, o conteúdo é ativo dele.
  retentionUntil DateTime @map("retention_until")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ad           Ad            @relation(fields: [adId], references: [id], onDelete: Cascade)
  variants     CopyVariant[]

  @@index([organizationId, adId, createdAt(sort: Desc)])
  @@index([organizationId, inputDigest])
  /// A cota mensal conta por aqui, e a poda varre por aqui.
  @@index([organizationId, status, createdAt])
  @@index([retentionUntil])
  @@map("copy_generations")
}

/// Uma variação como **ângulo**, não como sinônimo.
///
/// Três textos que dizem a mesma coisa com palavras diferentes testam redação;
/// três ângulos testam hipótese. É a diferença entre a feature e um gerador de
/// texto, e por isso `angle` é coluna e não metadado.
model CopyVariant {
  id             String @id @default(uuid())
  generationId   String @map("generation_id")
  organizationId String @map("organization_id")

  angle        CopyAngle
  hook         String?
  primaryText  String?   @map("primary_text")
  headline     String?
  description  String?
  callToAction String?   @map("call_to_action")

  /// "Por que a Allva recomenda esta versão" — ligado às sugestões que a
  /// originaram, e não texto solto do modelo. Schema Zod versionado.
  reasoning Json

  selected   Boolean   @default(false)
  selectedAt DateTime? @map("selected_at")

  /// O vínculo com a escrita que levou esta variante ao ar.
  ///
  /// **Nasce sem leitor, de propósito.** É a única coluna deste plano cuja
  /// ausência seria irreversível: sem ela, toda variante gerada antes da
  /// entrega de medição ficaria permanentemente não-mensurável, e "a variação B
  /// rendeu 18% mais CTR" só valeria a partir do dia em que alguém se lembrasse
  /// da coluna.
  appliedActionExecutionId String?   @map("applied_action_execution_id")
  appliedAt                DateTime? @map("applied_at")

  createdAt DateTime @default(now()) @map("created_at")

  generation CopyGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)

  @@index([organizationId, generationId])
  @@index([appliedActionExecutionId])
  @@map("copy_variants")
}

/// De onde o pedido nasceu. As três formas do produto, um motor só.
enum CopyGenerationSource {
  /// A mais valiosa: a Allva achou o problema e transformou a sugestão em texto.
  FROM_INSIGHT
  /// O usuário partiu da copy que está no ar.
  IMPROVE
  /// Ignora o texto atual e recomeça — **ainda ancorado no anúncio**.
  FROM_BRIEF
}

/// `AI_UNAVAILABLE` não é erro escondido: é a promessa da feature cumprida.
///
/// Provider fora do ar, resposta inválida ou corte no meio produzem uma linha
/// **com** contexto e sugestão e **sem** variante. O diagnóstico sobrevive à
/// queda da IA, e é isso que a distingue de um gerador de texto.
enum CopyGenerationStatus {
  COMPLETED
  AI_UNAVAILABLE
}

/// O ângulo da variação — a hipótese que ela testa.
enum CopyAngle {
  BENEFIT
  PAIN
  OUTCOME
  PROOF
  URGENCY
}

/// Configuração versionada de limiares. A calibração de P8 opera aqui, não no
