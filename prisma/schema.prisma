model PlanFeature {
  id     String @id @default(uuid())
  planId String @map("plan_id")

  /// Slug estavel da feature, igual nos quatro planos. E o que permite a tabela
  /// comparativa: sem ele, "50 / 300 / 2.000 / ilimitados" sao quatro linhas que
  /// nada relaciona, porque o numero vive dentro de `value` e `name` e so rotulo.
  key String

  name    String
  enabled Boolean

  /// O limite como texto de vitrine ("300", "13 meses", "Somente leitura").
  /// Nulo numa feature liga/desliga. **Nao e fonte de verdade de limite**: quem
  /// aplica teto continua sendo codigo (`PLAN_SEAT_LIMITS` e afins).
  value String?

  description String?
  sortOrder   Int     @default(0) @map("sort_order")

  /// A linha aparece no **card** do plano, e nao so na tabela comparativa.
  ///
  /// `enabled` continua sendo o que a guarda le; isto so decide o que cabe nas
  /// linhas do card — nove hoje, e o numero vive em `HIGHLIGHT_LIMIT`, nao aqui.
  /// A tabela comparativa mostra todas as linhas do catalogo e nao consulta esta
  /// coluna. Uniforme por `key`: os tres cards mostram as mesmas linhas, senao
  /// eles deixariam de se ler lado a lado.
  landingHighlight Boolean  @default(false) @map("landing_highlight")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  plan             Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
  @@index([planId, sortOrder])
  @@map("plan_features")
}

model Organization {
  id                String    @id @default(uuid())
  /// Quem criou a organizacao. **Deixou de ser unico**: uma holding, uma rede
  /// de franquias ou uma agencia com carteira precisa de organizacoes separadas
  /// — fronteira de dado, RBAC por unidade, faturamento por unidade — e o
  /// `@unique` recusava a segunda em qualquer plano, inclusive no Enterprise que
  /// a vendia. Quantas cada conta pode ter agora e decisao de plano
  /// (`organizations` no catalogo) e de contrato (`organization_quotas`).
  ///
  /// A posse continua espelhada numa participacao OWNER em `organization_users`,
  /// que e o que o RBAC le — esta coluna nomeia o criador, nao a permissao.
  ownerId           String    @map("owner_id")
  name              String
  cnpj              String?
  phone             String?
  address           String?
  addressNumber     String?   @map("address_number")
  addressComplement String?   @map("address_complement")
  addressCity       String?   @map("address_city")
  createdAt         DateTime  @default(now()) @map("created_at")
  deletedAt         DateTime? @map("deleted_at")

  /// Quando um humano declarou o nome desta organizacao.
  ///
  /// `null` = o nome foi **derivado** da conta no provisionamento do cadastro,
  /// e ninguem o confirmou. A organizacao passou a nascer junto com a conta para
  /// o produto ser organization-first sem cobrar mais um formulario no cadastro,
  /// e o preco disso e um nome como "Kevin de Oliveira" — que so fica estranho
  /// no unico lugar onde terceiros o leem: o e-mail de convite, que diz
  /// "convidou voce para participar da organizacao X".
  ///
  /// Coluna, e nao comparacao com `account.name` na leitura: quem se chama
  /// "Kevin de Oliveira" e nomeia a empresa "Kevin de Oliveira Consultoria"
  /// seria pego pela heuristica, e quem confirmasse o nome derivado seria
  /// perguntado para sempre. Um carimbo responde a pergunta uma vez.
  nameConfirmedAt DateTime? @map("name_confirmed_at")

  /// Desde quando a varredura dos jobs **observou** o acesso fechado.
  ///
  /// Não decide acesso — quem decide é o resolver, na leitura. Existe porque
  /// nada no banco diz *quando* o acesso fechou: o teste expira por data, o
  /// contrato fecha pela tolerância calculada na leitura, e a Stripe muda o
  /// status da assinatura sem carimbo. A primeira varredura que vê a
  /// organização sem acesso carimba; a primeira que a vê com acesso limpa.
  ///
  /// É a âncora da janela de sync diário de `CLOSED_ACCESS_DAILY_SYNC_HOURS`.
  /// A observação nunca vem antes do fechamento, então a janela real nunca é
  /// menor que a declarada.
  accessClosedAt DateTime? @map("access_closed_at")

  /// Moeda-base da organização: a unidade em que TODA inteligência raciocina
  /// (M1). A apresentação escolhe entre esta e a moeda da conta; a comparação
  /// entre contas de moedas diferentes só existe por causa dela.
  baseCurrency   String  @default("BRL") @map("base_currency")
  /// Kill switch instantâneo de escrita em plataforma (D4). Distinto do
  /// consentimento por integração — são dois controles, não um.
  actionsEnabled Boolean @default(false) @map("actions_enabled")

  /// Trocar a moeda-base recomputa toda coluna *Base da organização. Enquanto
  /// isso corre, a inteligência pausa (§8.7) e a API declara RECOMPUTING.
  currencyState         OrgCurrencyState @default(STABLE) @map("currency_state")
  previousBaseCurrency  String?          @map("previous_base_currency")
  baseCurrencyChangedAt DateTime?        @map("base_currency_changed_at")

  owner              Account                    @relation(fields: [ownerId], references: [id])
  users              OrganizationUser[]
  integrations       Integration[]
  invitations        OrganizationInvitation[]
  subscription       OrganizationSubscription?
  adAccounts         AdAccount[]
  adsSettings        OrganizationAdsSettings?
  quota              OrganizationQuota?
  usageCounters      OrganizationUsageCounter[]
  dailyDigests       OrganizationDailyDigest[]
  supportTickets     SupportTicket[]
  contracts          EnterpriseContract[]
  contractAmendments ContractAmendment[]
  copyGenerations    CopyGeneration[]

  @@index([ownerId])
  @@map("organizations")
}

model OrganizationUser {
  id             String                 @id @default(uuid())
  organizationId String                 @map("organization_id")
  accountId      String                 @map("account_id")
  role           OrganizationUserRole   @default(MEMBER)
  status         OrganizationUserStatus @default(INVITED)

  /// Congelamento por teto de assentos do plano.
  ///
  /// Distinto de `status = BLOCKED`, que e decisao de um administrador: o
  /// upgrade descongela o que o plano congelou e **nao** reativa quem alguem
  /// bloqueou de proposito. Mesma razao pela qual `ad_accounts.frozen_at` existe
  /// ao lado de `integration_id`.
  ///
  /// Data futura e agendamento — o cliente pagou o periodo. A leitura decide.
  frozenAt DateTime? @map("frozen_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user         Account      @relation(fields: [accountId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, accountId])
  @@index([organizationId])
  @@index([organizationId, frozenAt])
  @@map("organization_users")
}

