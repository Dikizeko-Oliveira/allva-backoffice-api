  @@unique([version, organizationId])
  @@map("detector_profiles")
}

/// FKs TIPADAS — nunca subject_type/subject_id.
model AIDecisionLog {
  id               String  @id @default(uuid())
  organizationId   String  @map("organization_id")
  adId             String? @map("ad_id")
  creativeUploadId String? @map("creative_upload_id")
  recommendationId String? @map("recommendation_id")

  taskType String @map("task_type")
  /// SEPARADO de `model`: o roteamento é multi-provider e o benchmark de custo
  /// precisa saber quem de fato atendeu.
  provider String
  model    String

  promptVersion String @map("prompt_version")

  outcome      AiCallOutcome
  /// Sem isto, todo benchmark de custo-por-modelo erra justamente nas chamadas
  /// que caíram para o secundário — que são as interessantes.
  fallbackUsed Boolean       @default(false) @map("fallback_used")

  inputTokens  Int?     @map("input_tokens")
  outputTokens Int?     @map("output_tokens")
  latencyMs    Int?     @map("latency_ms")
  costBase     Decimal? @map("cost_base") @db.Decimal(14, 6)

  /// A taxa USD → moeda-base usada para produzir `costBase`.
  ///
  /// **Sem ela o custo histórico é irreconstituível.** A tabela de preços é
  /// declarada em dólar e a conversão acontece na borda, com uma taxa de
  /// ambiente (`AI_USD_TO_BASE_RATE`). Um lançamento de R$ 0,0016 não dizia se
  /// usou 5,5 ou 6,2 — e no dia em que alguém atualiza a env, todo o passado
  /// passa a ser lido com a taxa nova, que não foi a que produziu o número.
  ///
  /// Com o carimbo, conciliar com a fatura do fornecedor vira uma consulta, e a
  /// atualização da taxa deixa de reescrever a história.
  ///
  /// Nula quando não houve custo a converter: chamada cortada antes de
  /// acontecer, ou moeda-base não conversível (`CURRENCY_NOT_CONVERTIBLE`).
  usdToBaseRate Decimal? @map("usd_to_base_rate") @db.Decimal(18, 8)

  /// Torna P9 auditável por query: "houve chamada sem mudança de digest?"
  inputDigest String? @map("input_digest")

  /// Conteúdo de marca do cliente e volume alto: hash sempre, texto atrás de
  /// flag com retenção curta.
  promptHash   String  @map("prompt_hash")
  responseText String? @map("response_text")
  errorPayload Json?   @map("error_payload")

  correlationId String?  @map("correlation_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@index([organizationId, provider, model, createdAt])
  @@index([adId])
  @@map("ai_decision_logs")
}

/// Chamada NÃO feita por teto (C9) ou por digest inalterado (P9) é informação de
/// produto: é a economia funcionando. Sem registro, é indistinguível de bug.
enum AiCallOutcome {
  SUCCEEDED
  FAILED
  SKIPPED_BUDGET
  SKIPPED_DIGEST
  /// O plano nao inclui enriquecimento por IA. Distinto de SKIPPED_BUDGET: um
  /// teto atingido e uma chamada que nunca foi oferecida sao coisas diferentes
  /// para quem analisa custo e para quem investiga "por que sumiu a narrativa?".
  SKIPPED_PLAN
}

/// Substitui referenceType/referenceId por SEIS FKs tipadas com CHECK de
/// exclusividade. Associação polimórfica por string é a causa raiz do alerta
/// órfão do v1: o worker passava `referenceType` sem nunca passar `referenceId`.
model Alert {
  id             String        @id @default(uuid())
  organizationId String        @map("organization_id")
  type           AlertType
  severity       AlertSeverity @default(INFO)
  title          String
  message        String

  /// São SEIS sujeitos, não cinco: `SYNC_QUARANTINE` e `AD_ARCHIVE_SUPPRESSED`
  /// são sobre a CONTA — na quarentena o anúncio sequer existe no domínio, que é
  /// justamente a razão do alerta.
  adId              String? @map("ad_id")
  adAccountId       String? @map("ad_account_id")
  wasteItemId       String? @map("waste_item_id")
  recommendationId  String? @map("recommendation_id")
  actionExecutionId String? @map("action_execution_id")
  integrationId     String? @map("integration_id")

  /// Dedupe com timestamps de DOMÍNIO. `updatedAt` não serve de última
  /// ocorrência: é @updatedAt e bumpa ao marcar como lido, o que faria o produto
  /// reportar "última ocorrência: agora" para condição que não recorre há uma semana.
  fingerprint     String
  occurrences     Int      @default(1)
  firstOccurredAt DateTime @default(now()) @map("first_occurred_at")
  lastOccurredAt  DateTime @default(now()) @map("last_occurred_at")

  readAt      DateTime? @map("read_at")
  dismissedAt DateTime? @map("dismissed_at")
  resolvedAt  DateTime? @map("resolved_at")
  notifiedAt  DateTime? @map("notified_at")

  correlationId String?  @map("correlation_id")
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([organizationId, type, resolvedAt])
  @@index([organizationId, readAt])
  @@map("alerts")
}

