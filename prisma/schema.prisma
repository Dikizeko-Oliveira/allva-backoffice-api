// ─────────────────────────────────────────────────────────────────────────────
// ALLVA Ads Intelligence v2.0 — domínio de mídia e inteligência (A2-S1)
//
// Fonte de verdade: docs/allva-ads-intelligence-architecture-v2-revisada.md §4.
// O schema nasce inteiro e correto numa migração destrutiva (§14.1, D9.1) —
// não há dado de mídia a preservar, e a janela fecha no primeiro onboarding real.
//
// As três regras que governam tudo abaixo:
//   P10  a identidade ancora em AdAccount, nunca na credencial (Integration)
//   P2   o anúncio é a unidade de verdade: ad_id NOT NULL em toda inteligência
//   R-M  todo valor monetário é persistido duas vezes: original e moeda-base
// ─────────────────────────────────────────────────────────────────────────────

/// Âncora de identidade do domínio (R-I / P10). Reconectar repontua
/// `integrationId`; nenhuma entidade filha é recriada, nenhum id muda.
model AdAccount {
  id                String   @id @default(uuid())
  accountId         String   @map("account_id")
  organizationId    String   @map("organization_id")
  platform          Platform
  externalAccountId String   @map("external_account_id")
  name              String

  /// Credencial CORRENTE, substituível — por isso nullable e fora de toda unique.
  integrationId      String? @map("integration_id")
  /// Fonte de verdade monetária e temporal da conta.
  currency           String
  timezone           String
  attributionSetting String? @map("attribution_setting")

  /// Janela de atribuição lida da plataforma. A de re-declaração é
  /// max(env, attributionWindowDays): duas contas da MESMA organização podem
  /// ter 7 e 28 dias, e tratá-las igual perde conversão sempre nas mesmas (D16).
  attributionWindowDays Int? @map("attribution_window_days")
  restatementWindowDays Int  @default(14) @map("restatement_window_days")

  /// Saúde de sincronização (D17). É isto que a tabela de degradação de §8.7 lê:
  /// "não conseguimos ver tudo" é propriedade da conta, não de um anúncio.
  /// Congelamento por plano — **o instante a partir do qual a conta sai de cena**.
  ///
  /// Futuro é agendamento: um downgrade marcado para o fim do periodo pago
  /// carimba a data de virada, e nada muda ate la. A leitura decide
  /// (`frozenAt <= now`), como a expiracao do teste: correcao de acesso nao
  /// espera job rodar, e aqui o unico que aplicaria o plano e o webhook da Stripe.
  ///
  /// Coluna propria, e nao "desvincular": desvincular perde o vinculo e obriga a
  /// reconectar. Congelar preserva tudo, e e o que permite o upgrade descongelar
  /// exatamente o que o plano congelou — sem reativar conta que o usuario
  /// desligou de proposito.
  frozenAt DateTime? @map("frozen_at")

  syncHealth               AdAccountSyncHealth @default(HEALTHY) @map("sync_health")
  syncHealthReason         String?             @map("sync_health_reason")
  unreachableSince         DateTime?           @map("unreachable_since")
  lastSuccessfulFullSyncAt DateTime?           @map("last_successful_full_sync_at")

  discoveredAt   DateTime  @default(now()) @map("discovered_at")
  lastFullSyncAt DateTime? @map("last_full_sync_at")

  organization   Organization     @relation(fields: [organizationId], references: [id])
  integration    Integration?     @relation(fields: [integrationId], references: [id])
  campaigns      Campaign[]
  adSets         AdSet[]
  ads            Ad[]
  creatives      Creative[]
  syncOperations SyncOperation[]
  quarantine     SyncQuarantine[]

  @@unique([organizationId, platform, externalAccountId])
  @@index([integrationId])
  @@index([organizationId, syncHealth])
  /// O sync e a quota filtram por integracao viva + nao congelada.
  @@index([organizationId, frozenAt])
  @@map("ad_accounts")
}

enum AdAccountSyncHealth {
  HEALTHY
  DEGRADED
  UNREACHABLE
}

/// O resumo diário da organização — **P9 aplicado a um texto**.
///
/// A unique `(organizationId, digestDate)` é o que faz "uma vez ao dia" ser
/// invariante de banco: o job não consegue gravar dois resumos para o mesmo dia
/// mesmo se enfileirado duas vezes, e cada gravação a mais seria uma chamada de
/// LLM a mais.
///
/// `inputDigest` é o hash dos **fatos**, não do texto: fatos iguais aos de
/// ontem ⇒ o texto é copiado e nenhum provider é chamado (`SKIPPED_DIGEST`).
model OrganizationDailyDigest {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  /// O dia a que o resumo se refere, em UTC.
  digestDate     DateTime @map("digest_date") @db.Date

  /// Hash dos fatos. Igual ao do dia anterior ⇒ nenhuma chamada de LLM.
  inputDigest String @map("input_digest")

  /// Os fatos determinísticos que sustentam o texto — são a resposta quando a
  /// IA não está disponível (P4), e o que torna o texto auditável depois.
  facts Json

  /// `null` quando a IA não pôde falar. O card continua inteiro sem ela.
  narrative    String?
  enrichedByAI Boolean @default(false) @map("enriched_by_ai")

  /// D16 — a versão de prompt que produziu ESTE texto.
  promptVersion String? @map("prompt_version")

  /// Aponta o dia de origem quando o texto foi reaproveitado por digest igual.
  reusedFromDate DateTime? @map("reused_from_date") @db.Date

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, digestDate], map: "organization_daily_digests_org_date_key")
  @@index([organizationId, digestDate(sort: Desc)], map: "organization_daily_digests_org_date_idx")
  @@map("organization_daily_digests")
}

/// Configuração por organização (D16). Sem ela, "versão ativa" vira constante de
/// código, a janela configurável de D8 não é cumprível e P9 não tem teto.
model OrganizationAdsSettings {
  organizationId String @id @map("organization_id")

  scoringWindowDays            Int    @default(14) @map("scoring_window_days")
  activeAlgoVersion            String @default("deterministic-v2.2") @map("active_algo_version")
  activeDetectorProfileVersion String @default("waste-thresholds-v1") @map("active_detector_profile_version")

  /// Por TAREFA, não global: narrativa, sugestão criativa e título de
  /// recomendação evoluem em ritmos diferentes. Chave = taskType.
  activePromptVersions Json @default("{}") @map("active_prompt_versions")

  /// O teto diário de gasto com IA, em moeda-base.
  ///
  /// ## Por que tem default, e por que ele demorou
  ///
  /// A coluna nasceu anulável e sem default, com `evaluateBudget` documentando
  /// que nulo **permite**. O efeito era que nenhuma organização tinha parede: a
  /// narrativa noturna sai para todo score novo — ~2.000/noite no teto do
  /// Profissional, R$ 99/mês — e era o maior gasto de IA do produto, sem teto e
  /// sem cota. As duas cotas mensais do Creative Lab não o cobrem: elas medem o
  /// que se pede por clique, e isto é o que o job da madrugada produz sozinho.
  ///
  /// ## Por que 50, e não 5 nem 500
  ///
  /// É uma parede de **descontrole**, não um orçamento. Ela não pode cortar o
  /// que o plano vende, nem no pior caso previsto: com a OpenAI fora do ar a
  /// rota cai para `claude-sonnet-5`, 8,8× mais caro, e os 2.000 anúncios do
  /// Profissional custam R$ 28,86/dia. Um teto abaixo disso transformaria um
  /// incidente de fornecedor em queda de produto — o mesmo erro que o roteador
  /// já registra ao explicar por que o modelo caro saiu das narrativas.
  ///
  /// Em operação normal o Profissional gasta ~R$ 3,80/dia, 7% deste teto. Bater
  /// nele significa que algo quebrou — laço, modelo mal roteado, volume dez
  /// vezes acima do contratado — e é exatamente aí que se quer a parede.
  ///
  /// Contrato Enterprise acima de 5.000 anúncios monitorados precisa de número
  /// próprio, gravado pelo operador. Como todo o resto que o contrato negocia.
  llmDailyBudgetBase Decimal? @default(50) @map("llm_daily_budget_base") @db.Decimal(14, 4)
  actionDailyCap     Int?     @map("action_daily_cap")

  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("organization_ads_settings")
}

/// Tetos **negociados por contrato**, acima dos que o plano publica.
///
/// Existe porque "Ilimitado" era desconto, nao entrega: quem tinha 40 contas de
/// anuncios pagava o mesmo que quem tinha 400, e o custo marginal — LLM, cota de
/// API, storage — nao tinha teto do nosso lado. O Enterprise passou a nomear um
/// piso no catalogo, e o numero real de cada contrato mora aqui.
///
/// `null` em qualquer coluna e **"herda o plano"**, nunca "ilimitado". A
/// distincao importa: ilimitado deixou de existir, e uma coluna vazia lida como
/// ilimitada reintroduziria justamente o que esta tabela veio remover.
///
/// **Nao vale em previa de downgrade.** Quem desce de plano sai do contrato que
/// negociou o teto, entao `AdAccountFreezeService` e `MembershipFreezeService`
/// continuam lendo a cota do plano de destino, e nao esta.
model OrganizationQuota {
  organizationId String @id @map("organization_id")

  maxAdAccounts    Int? @map("max_ad_accounts")
  maxOrganizations Int? @map("max_organizations")
  maxMonitoredAds  Int? @map("max_monitored_ads")
  maxSeats         Int? @map("max_seats")

  /// O teto mensal de gerações de copy negociado em contrato.
  ///
  /// `null` herda o plano, como as quatro acima — nunca "ilimitado". É por aqui
  /// que o "customizado" do Enterprise existe sem que o catálogo publique um
  /// número que o comercial não possa mover.
  maxCopyGenerationsMonthly Int? @map("max_copy_generations_monthly")

  /// O teto mensal de análises de criativo negociado em contrato.
  ///
  /// Mesma regra das irmãs: `null` herda o plano, nunca "ilimitado". É o que
  /// faz o "sob medida" do Enterprise valer também para a análise por clique —
  /// antes ela não tinha teto nenhum para negociar.
  maxCreativeAnalysesMonthly Int? @map("max_creative_analyses_monthly")

  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_quotas")
}

/// O consumo já **autorizado** de uma cota, no período corrente.
///
/// ## Por que existe, depois de a cota de copy ter decidido não ter contador
///
/// A decisão original — "o medidor é a própria tabela" — evitava fechamento de
/// mês e conciliação, e estava certa sobre isso. O que ela não resolvia é
/// concorrência: `COUNT` e depois `INSERT` não são atômicos, então dois pedidos
/// simultâneos com 99 de 100 usados liam 99 os dois e passavam os dois. O teto
/// virava "100, mais ou menos" — e a tela podia mostrar 101 de 100, que é a
/// forma mais visível possível de dizer ao cliente que o número não vale.
///
/// Aqui a reserva **é** a escrita: `INSERT … ON CONFLICT DO UPDATE … WHERE used
/// < limite` avalia o predicado já com a trava da linha na mão, então o segundo
/// pedido enxerga o primeiro. Não há janela onde caibam dois.
///
/// ## Não é espelho da tabela, e por isso não precisa de conciliação
///
/// O que esta linha conta é **autorização concedida**, que é exatamente o que
/// uma cota governa. A tabela de destino continua sendo o registro do que foi
/// produzido. Quando o trabalho autorizado não acontece — provider fora do ar,
/// falha ao persistir — quem reservou devolve a unidade, e é por isso que as
/// duas convergem sem ninguém rodar um job de acerto.
///
/// A retenção também deixa de importar: `copy_generations` é expurgada aos 60
/// dias, e um medidor que contasse a tabela veria a cota do mês encolher
/// sozinha no dia em que a política mudasse.
model OrganizationUsageCounter {
  organizationId String @map("organization_id")

  /// A chave do catálogo (`copy-generation`, `creative-analyses`).
  ///
  /// Texto e não enum: o vocabulário é o de `PLAN_FEATURE_SPECS`, e um enum
  /// obrigaria uma migração para cada linha nova do packaging — que é
  /// precisamente o acoplamento que o catálogo-como-dado existe para evitar.
  feature String

  /// Primeiro instante da janela, em UTC — o mesmo `monthWindow` das guardas.
  ///
  /// Faz parte da chave para que a virada do mês seja uma linha nova, e não um
  /// job de fechamento. Nada zera nada: o período seguinte simplesmente não
  /// existe ainda.
  periodStart DateTime @map("period_start")

  used Int @default(0)

  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, feature, periodStart])
  @@map("organization_usage_counters")
}

/// Coletada SEMPRE contra FX_PIVOT_CURRENCY (padrão USD); qualquer par sai por
/// taxa cruzada. Acessada exclusivamente pelo módulo `currency` (§16.10).
model FxRate {
  id           String   @id @default(uuid())
  date         DateTime @db.Date
  fromCurrency String   @map("from_currency")
  toCurrency   String   @map("to_currency")
  rate         Decimal  @db.Decimal(18, 8)
  source       String
  fetchedAt    DateTime @default(now()) @map("fetched_at")

  @@unique([date, fromCurrency, toCurrency, source])
  @@index([fromCurrency, toCurrency, date])
  @@map("fx_rates")
}

/// O recomputo de moeda-base. Sem esta tabela, RECOMPUTING_CURRENCY não tem onde
/// registrar progresso, escopo nem retomada, e a degradação de §8.7 fica sem lastro.
model CurrencyMigration {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  fromCurrency   String @map("from_currency")
  toCurrency     String @map("to_currency")

  status               CurrencyMigrationStatus @default(PENDING)
  requestedByAccountId String                  @map("requested_by_account_id")
  requestedAt          DateTime                @default(now()) @map("requested_at")
  startedAt            DateTime?               @map("started_at")
  completedAt          DateTime?               @map("completed_at")

  /// Cancelar só é seguro ANTES de escrever. De RUNNING, o pedido é intenção: o
  /// worker o observa no próximo checkpoint e termina em ROLLED_BACK.
  cancellationRequestedAt   DateTime? @map("cancellation_requested_at")
  cancellationRequestedById String?   @map("cancellation_requested_by_id")

  /// { tabela -> { lastId, rowsDone, rowsTotal } } — é o que permite retomar.
  progress      Json?
  rowCounts     Json?   @map("row_counts")
  correlationId String? @map("correlation_id")
  errorMessage  String? @map("error_message")

  @@index([organizationId, status])
  @@map("currency_migrations")
}

enum CurrencyMigrationStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  ROLLED_BACK
}

// ─── Contexto: Campaign e AdSet (§4.2) — read-only, sem inteligência própria ───

model Campaign {
  id                   String             @id @default(uuid())
  adAccountId          String             @map("ad_account_id")
  organizationId       String             @map("organization_id")
  integrationId        String             @map("integration_id")
  platform             Platform
  externalCampaignId   String             @map("external_campaign_id")
  name                 String
  status               String?
  objective            String?
  /// O objetivo traduzido para a taxonomia canônica (`optimization-target.ts`).
  /// Nulo = ainda não lido. É o fallback do anúncio quando o conjunto não
  /// declara meta de otimização.
  optimizationClass    OptimizationClass? @map("optimization_class")
  conversionEvent      String?            @map("conversion_event")
  conversionMeasurable Boolean            @default(false) @map("conversion_measurable")
  dailyBudget          Decimal?           @map("daily_budget") @db.Decimal(14, 4)
  lifetimeBudget       Decimal?           @map("lifetime_budget") @db.Decimal(14, 4)
  currency             String
  startedAt            DateTime?          @map("started_at")
  endedAt              DateTime?          @map("ended_at")
  metadata             Json?
  lastSyncedAt         DateTime           @default(now()) @map("last_synced_at")
  archivedAt           DateTime?          @map("archived_at")

  adAccount AdAccount @relation(fields: [adAccountId], references: [id])
  adSets    AdSet[]
  ads       Ad[]

  @@unique([adAccountId, externalCampaignId])
  @@index([organizationId])
  @@map("campaigns")
}

model AdSet {
  id                   String             @id @default(uuid())
  adAccountId          String             @map("ad_account_id")
  organizationId       String             @map("organization_id")
  campaignId           String             @map("campaign_id")
  platform             Platform
  externalAdSetId      String             @map("external_ad_set_id")
  name                 String
  status               String?
  optimizationGoal     String?            @map("optimization_goal")
  billingEvent         String?            @map("billing_event")
  /// A meta de otimização traduzida: decide se o anúncio é julgado por
  /// conversão e o que conta como conversão nele (compra, lead, cadastro...).
  optimizationClass    OptimizationClass? @map("optimization_class")
  conversionEvent      String?            @map("conversion_event")
  conversionMeasurable Boolean            @default(false) @map("conversion_measurable")
  dailyBudget          Decimal?           @map("daily_budget") @db.Decimal(14, 4)
  lifetimeBudget       Decimal?           @map("lifetime_budget") @db.Decimal(14, 4)
  targeting            Json?
  archivedAt           DateTime?          @map("archived_at")

  adAccount AdAccount @relation(fields: [adAccountId], references: [id])
  campaign  Campaign  @relation(fields: [campaignId], references: [id])
  ads       Ad[]

  @@unique([adAccountId, externalAdSetId])
  @@index([campaignId])
  @@map("ad_sets")
}

// ─── O Aggregate Root (§4.3) ──────────────────────────────────────────────────

model Ad {
  id             String @id @default(uuid())
  accountId      String @map("account_id")
  organizationId String @map("organization_id")

  adAccountId   String   @map("ad_account_id")
  integrationId String   @map("integration_id")
  platform      Platform
  externalAdId  String   @map("external_ad_id")

  /// `campaignId` é a FK canônica (NOT NULL). `adSetId` é nullable por design,
  /// para plataformas sem o nível intermediário.
  campaignId String  @map("campaign_id")
  adSetId    String? @map("ad_set_id")
  creativeId String? @map("creative_id")
  name       String

  /// O que a plataforma entrega como unidade (D23). `ASSET_GROUP` é o grupo de
  /// recursos do Performance Max: pende direto da campanha (`adSetId` nulo), e
  /// é a plataforma quem combina os recursos dele em peças. Decide com quem a
  /// unidade se compara, que ações existem sobre ela e como a tela a chama.
  unitKind AdUnitKind @default(AD) @map("unit_kind")

  /// Identidade de linhagem (§3.6): default = próprio id, herdado por ad
  /// derivado de ação que recria. Séries agrupam por aqui, não por `id`.
  lineageId               String  @map("lineage_id")
  originAdId              String? @map("origin_ad_id")
  originActionExecutionId String? @map("origin_action_execution_id")

  /// Lock otimista — a outra metade de I2.
  version Int @default(0)

  /// Estado observado (dono: sync). `observedAsOf` é o instante DO DADO na
  /// plataforma, não o da leitura — é o que sustenta a guarda de recência.
  observedStatus    AdStatus  @default(UNKNOWN) @map("observed_status")
  observedRawStatus String?   @map("observed_raw_status")
  observedAsOf      DateTime? @map("observed_as_of")

  /// Estado desejado (dono: platform-actions). Separado do observado de
  /// propósito: fundi-los é dizer "pausado" quando o certo é "pausando…".
  desiredStatus      AdStatus? @map("desired_status")
  desiredStatusSetAt DateTime? @map("desired_status_set_at")

  syncState           AdSyncState @default(STALE) @map("sync_state")
  syncStateAt         DateTime?   @map("sync_state_at")
  driftDetails        Json?       @map("drift_details")
  lastStructureSyncAt DateTime?   @map("last_structure_sync_at")
  lastMetricsSyncAt   DateTime?   @map("last_metrics_sync_at")

  /// Dono: sync. Deriva da janela de atribuição da conta contra a data do dado —
  /// é propriedade da observação, não do cálculo (§5.4).
  dataMaturity DataMaturity? @map("data_maturity")

  /// Denormalizações de leitura POR VALOR, nunca fonte de verdade (§5.5).
  /// `currentScoreCoverage` e `dataMaturity` existem aqui por necessidade: §12.4
  /// barra da ordenação quem está abaixo do piso e §7.1 filtra por maturidade —
  /// sem as colunas, `GET /ads` precisaria de join na série e o p95 < 400 ms morre.
  currentScoreId         String?   @map("current_score_id")
  currentAiScore         Float?    @map("current_ai_score")
  currentScoreConfidence Float?    @map("current_score_confidence")
  currentScoreCoverage   Float?    @map("current_score_coverage")
  scoreDelta7d           Float?    @map("score_delta_7d")
  scoreAsOf              DateTime? @map("score_as_of")
  /// A régua de plano da noite (§ teto de anúncios analisados).
  ///
  /// Nulo significa **fora do conjunto analisado**: o anúncio continua
  /// sincronizado, visível e com métricas, e apenas não entra no scoring nem na
  /// deteccao daquela noite. Recusar o ingest seria pior — o total de
  /// desperdicio da organizacao passaria a ser calculado sobre dado que nunca
  /// foi lido, e um numero errado e pior que um numero declaradamente parcial.
  ///
  /// O carimbo e o instante da corrida que decidiu, e existe para que "por que
  /// este anuncio nao foi analisado?" tenha resposta sem adivinhacao.
  analysisEligibleAt     DateTime? @map("analysis_eligible_at")

  /// A ultima vez que este anuncio **entrou** no conjunto analisado.
  ///
  /// Diferente de `analysisEligibleAt`, que a regua zera toda noite para quem
  /// ficou de fora: este carimbo nunca e apagado. E a memoria que o rodizio
  /// precisa — sem ela, "ha quanto tempo este anuncio nao e olhado?" nao tem
  /// resposta, e a faixa de rodizio nao teria como ordenar por negligencia.
  ///
  /// Nulo significa **nunca analisado**, e e por isso que o rodizio ordena com
  /// `NULLS FIRST`: quem nunca entrou tem prioridade sobre quem entrou ha muito.
  analysisLastScopedAt DateTime? @map("analysis_last_scoped_at")

  openWasteCount           Int       @default(0) @map("open_waste_count")
  openWasteAmount          Decimal   @default(0) @map("open_waste_amount") @db.Decimal(14, 4)
  openWasteCurrency        String?   @map("open_waste_currency")
  openWasteAmountBase      Decimal   @default(0) @map("open_waste_amount_base") @db.Decimal(14, 4)
  avoidableDailyAmountBase Decimal   @default(0) @map("avoidable_daily_amount_base") @db.Decimal(14, 4)
  wasteAsOf                DateTime? @map("waste_as_of")

  /// O que a detecção **não pôde julgar** neste anúncio, e por quê (P7).
  ///
  /// Dono: `waste`, na mesma escrita das denormalizações de desperdício. Cada
  /// entrada é um motivo (dias, gasto, conversões, maturidade, comparação,
  /// objetivo), com os detectores afetados e a estimativa de quando a evidência
  /// chega. Sem isto, "não há desperdício" e "ainda não dá para dizer" eram a
  /// mesma lista vazia na tela.
  evidenceGaps     Json?     @map("evidence_gaps")
  evidenceGapsAsOf DateTime? @map("evidence_gaps_as_of")

  metadata    Json?
  firstSeenAt DateTime  @default(now()) @map("first_seen_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  archivedAt  DateTime? @map("archived_at")

  adAccount AdAccount @relation(fields: [adAccountId], references: [id])
  campaign  Campaign  @relation(fields: [campaignId], references: [id])
  adSet     AdSet?    @relation(fields: [adSetId], references: [id])
  creative  Creative? @relation(fields: [creativeId], references: [id])

  snapshots        AdMetricSnapshot[]
  scores           AdScore[]
  wasteItems       WasteItem[]
  recommendations  Recommendation[]
  actions          AdAction[]
  syncOperations   SyncOperation[]
  creativeAnalyses CreativeAnalysis[]
  copyGenerations  CopyGeneration[]

  @@unique([adAccountId, externalAdId])
  @@index([organizationId, currentAiScore, id])
  @@index([organizationId, scoreDelta7d, id])
  @@index([organizationId, avoidableDailyAmountBase(sort: Desc), id])
  @@index([organizationId, syncState])
  @@index([organizationId, campaignId])
  @@index([lineageId])
  @@index([adAccountId, archivedAt])
  /// Os dois motores filtram por conta + elegibilidade toda noite.
  @@index([adAccountId, analysisEligibleAt])
  /// A faixa de rodizio ordena por negligencia dentro da organizacao.
  @@index([organizationId, analysisLastScopedAt])
  @@map("ads")
}

enum AdStatus {
  ACTIVE
  PAUSED
  ARCHIVED
  DELETED
  PENDING_REVIEW
  DISAPPROVED
  UNKNOWN
}

enum AdSyncState {
  IN_SYNC
  PENDING_WRITE
  DRIFTED
  STALE
  UNREACHABLE
}

enum DataMaturity {
  IMMATURE
  SETTLING
  MATURE
}

// ─── Métricas e criativos (§4.4) ──────────────────────────────────────────────

/// Particionada por RANGE(date) desde a criação (§14.3). Uma granularidade só:
/// nível CAMPAIGN/ADSET não existe no armazenamento, e é isso que elimina a
/// classe inteira de bugs de dupla contagem.
///
/// A PK é composta `(id, date)` — não `id` sozinho, como §4.4 sugere. O Postgres
/// exige que toda unique de uma tabela particionada contenha a chave de
/// partição; um `@id` simples não seria criável. É a única forma de a tabela
/// nascer particionada, que §14.3 declara irreversível.
model AdMetricSnapshot {
  id             String            @default(uuid())
  adId           String            @map("ad_id")
  organizationId String            @map("organization_id")
  adAccountId    String            @map("ad_account_id")
  platform       Platform
  date           DateTime          @db.Date
  granularity    MetricGranularity @default(DAY)

  campaignId String  @map("campaign_id")
  adSetId    String? @map("ad_set_id")
  creativeId String? @map("creative_id")

  /// Ratios (ctr, cpc, cpa, roas) são DERIVADOS, nunca armazenados: persistí-los
  /// é convite a inconsistência quando linhas são agregadas.
  spend         Decimal @default(0) @db.Decimal(14, 4)
  impressions   Int     @default(0)
  clicks        Int     @default(0)
  conversions   Int     @default(0)
  revenue       Decimal @default(0) @db.Decimal(14, 4)
  reach         Int?
  frequency     Float?
  videoViews    Int?    @map("video_views")
  engagement    Int?
  thumbstopRate Float?  @map("thumbstop_rate")
  holdRate      Float?  @map("hold_rate")

  /// Sinais de feedback negativo — o que torna NegativeFeedbackRisk real (§12.2).
  hides      Int? @map("hides")
  hideAllFor Int? @map("hide_all_for")
  reports    Int?
  unlikes    Int?

  /// Dupla persistência (R-M). A taxa é fixada na ingestão e nunca recalculada
  /// (M2): converter na leitura faria o desperdício histórico variar todo dia
  /// sem nada ter acontecido.
  currency             String
  baseCurrency         String    @map("base_currency")
  spendBase            Decimal   @default(0) @map("spend_base") @db.Decimal(14, 4)
  revenueBase          Decimal   @default(0) @map("revenue_base") @db.Decimal(14, 4)
  fxRate               Decimal?  @map("fx_rate") @db.Decimal(18, 8)
  fxAsOf               DateTime? @map("fx_as_of") @db.Date
  fxSource             String?   @map("fx_source")
  normalizationPending Boolean   @default(false) @map("normalization_pending")

  accountTimezone     String  @map("account_timezone")
  attributionSetting  String? @map("attribution_setting")
  /// O MOTIVO, nunca um booleano (§12.5, A12): `true` diz que a série quebrou
  /// e não diz por quê, e as cinco causas pedem tratamentos diferentes. Mesmo
  /// tipo de `AdScore.seriesDiscontinuity` — dois tipos para o mesmo conceito
  /// obrigariam cada consumidor a traduzir, e a tradução é onde a causa se perde.
  seriesDiscontinuity String? @map("series_discontinuity")

  syncedAt DateTime @default(now()) @map("synced_at")

  ad Ad @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@id([id, date])
  @@unique([adId, date, granularity])
  @@index([organizationId, date])
  @@index([creativeId, date])
  @@index([campaignId, date])
  @@map("ad_metric_snapshots")
}

model Creative {
  id                 String   @id @default(uuid())
  adAccountId        String   @map("ad_account_id")
  organizationId     String   @map("organization_id")
  platform           Platform
  externalCreativeId String   @map("external_creative_id")
  name               String?
  title              String?
  body               String?
  callToAction       String?  @map("call_to_action")
  format             String?
  durationMs         Int?     @map("duration_ms")
  width              Int?
  height             Int?
  thumbnailUrl       String?  @map("thumbnail_url")
  videoUrl           String?  @map("video_url")
  imageUrl           String?  @map("image_url")
  landingPageUrl     String?  @map("landing_page_url")

  /// Fingerprint de CONTEÚDO: reconhece o mesmo criativo entre contas e
  /// plataformas. Não é linhagem — `lineageId` faz o outro trabalho.
  contentHash String? @map("content_hash")

  metadata     Json?
  lastSyncedAt DateTime  @default(now()) @map("last_synced_at")
  archivedAt   DateTime? @map("archived_at")

  adAccount AdAccount          @relation(fields: [adAccountId], references: [id])
  ads       Ad[]
  analyses  CreativeAnalysis[]

  @@unique([adAccountId, externalCreativeId])
  @@index([organizationId])
  @@index([contentHash])
  @@map("creatives")
}

// ─── Inteligência (§4.5) ──────────────────────────────────────────────────────

model AdScore {
  id             String  @id @default(uuid())
  adId           String  @map("ad_id")
  organizationId String  @map("organization_id")
  /// O criativo VIGENTE no momento da pontuação.
  creativeId     String? @map("creative_id")

  scoredAt    DateTime @default(now()) @map("scored_at")
  scoreDate   DateTime @map("score_date") @db.Date
  windowStart DateTime @map("window_start") @db.Date
  windowEnd   DateTime @map("window_end") @db.Date
  windowDays  Int      @map("window_days")
  algoVersion String   @map("algo_version")
  priorWeight Float    @map("prior_weight")

  aiScore      Float @map("ai_score")
  aiConfidence Float @map("ai_confidence")

  /// As TRÊS grandezas de §12.2. `componentCoverage` é a honestidade absoluta e
  /// é o que a tela exibe; `coverageRatio` é onde os pisos de §12.4 incidem
  /// (DEC-2) — com piso absoluto, Search no Google sumiria de toda ordenação.
  componentCoverage   Float  @map("component_coverage")
  coverageRatio       Float? @map("coverage_ratio")
  platformCoverageMax Float? @map("platform_coverage_max")

  /// Cada componente persiste value (escala nativa), normalizedValue (0..100 ↑),
  /// confidence, available e reasons. Validado por schema Zod versionado (E1).
  components Json

  /// Contexto declarado, FORA do composto: saturationRisk com scopeLevel AD_SET.
  context Json?

  /// Motivo, não booleano: delta, tendência e alerta não atravessam uma
  /// descontinuidade, e "por quê" é o que a tela precisa mostrar (§12.5).
  seriesDiscontinuity String?   @map("series_discontinuity")
  frozenAt            DateTime? @map("frozen_at")

  /// P9: sem mudança de digest, nenhuma chamada de LLM no dia seguinte.
  inputDigest String  @map("input_digest")
  aiNarrative String? @map("ai_narrative")
  aiProvider  String? @map("ai_provider")
  aiModel     String? @map("ai_model")

  ad Ad @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@unique([adId, scoreDate, algoVersion, scoredAt])
  @@index([adId, scoreDate(sort: Desc)])
  @@index([organizationId, algoVersion, scoreDate])
  @@index([organizationId, aiConfidence, coverageRatio], map: "ad_scores_org_floors_idx")
  @@map("ad_scores")
}

model WasteItem {
  id             String  @id @default(uuid())
  adId           String  @map("ad_id")
  organizationId String  @map("organization_id")
  accountId      String  @map("account_id")
  creativeId     String? @map("creative_id")

  findingKind FindingKind   @default(WASTE) @map("finding_kind")
  type        FindingType
  status      WasteStatus   @default(OPEN)
  priority    WastePriority @default(MEDIUM)
  windowDays  Int           @map("window_days")

  /// Duas grandezas, nunca uma (§10.1): o que já foi gasto e o que dá para
  /// interromper hoje. Somar as duas é somar passado com futuro.
  incurredAmount       Decimal @default(0) @map("incurred_amount") @db.Decimal(14, 4)
  incurredAmountBase   Decimal @default(0) @map("incurred_amount_base") @db.Decimal(14, 4)
  avoidableDailyAmount Decimal @default(0) @map("avoidable_daily_amount") @db.Decimal(14, 4)
  avoidableDailyBase   Decimal @default(0) @map("avoidable_daily_base") @db.Decimal(14, 4)
  currency             String
  baseCurrency         String  @map("base_currency")

  diagnosis              String
  /// thresholds, observed, scopeLevel, relatedAdIds, attributionRule.
  evidence               Json
  evidenceSufficiency    String @map("evidence_sufficiency")
  scopeLevel             String @map("scope_level")
  dataMaturity           String @map("data_maturity")
  detectorVersion        String @map("detector_version")
  detectorProfileVersion String @map("detector_profile_version")
  detectorGeneration     Int    @default(2) @map("detector_generation")

  /// sha256(adId|type) — SEM versão, senão cada bump de detector reabre tudo.
  fingerprint      String
  occurrences      Int      @default(1)
  detectedAt       DateTime @default(now()) @map("detected_at")
  lastSeenAt       DateTime @default(now()) @map("last_seen_at")
  /// Sem sync bem-sucedido nada é resolvido; o item fica aberto e declarado velho.
  staleObservation Boolean  @default(false) @map("stale_observation")

  resolvedAt                  DateTime?            @map("resolved_at")
  resolutionKind              WasteResolutionKind? @map("resolution_kind")
  resolvedByActionExecutionId String?              @map("resolved_by_action_execution_id")
  resolvedByAccountId         String?              @map("resolved_by_account_id")

  ad                        Ad                        @relation(fields: [adId], references: [id], onDelete: Cascade)
  resolvedByActionExecution ActionExecution?          @relation("WasteResolution", fields: [resolvedByActionExecutionId], references: [id], onDelete: SetNull)
  recommendations           RecommendationWasteItem[]

  @@index([organizationId, findingKind, status, priority, id])
  @@index([adId, status])
  @@map("waste_items")
}

/// Reduzido a dois valores DE PROPÓSITO (D10). A nuance vive inteira em
/// `WasteResolutionKind`; mantê-la nos dois enums é o que produz divergência
/// entre a view `open_waste` e a listagem.
enum WasteStatus {
  OPEN
  RESOLVED
}

enum FindingKind {
  WASTE
  OPPORTUNITY
}

enum FindingType {
  ZERO_CONVERSIONS
  LOW_CTR
  HIGH_CPA
  LOW_ROAS
  CREATIVE_FATIGUE
  AUDIENCE_SATURATION
  LEARNING_INSTABILITY
  NEGATIVE_FEEDBACK
  OVERLAPPING_DELIVERY
  BUDGET_STARVATION
}

enum WasteResolutionKind {
  RESOLVED_BY_ACTION
  RESOLVED_EXTERNALLY
  /// Dado re-declarado desfez o achado: é falso positivo, não acerto. Separá-lo
  /// é o que preserva a honestidade do dataset de P8.
  RESOLVED_BY_RESTATEMENT
  DISMISSED
  STALE
  /// Mudança de LÓGICA do detector, nunca de limiar.
  SUPERSEDED_BY_DETECTOR
}

model Recommendation {
  id             String @id @default(uuid())
  adId           String @map("ad_id")
  organizationId String @map("organization_id")
  accountId      String @map("account_id")

  kind             RecommendationKind
  /// Remédio fora do escopo da Allva: nunca entra nas métricas de acurácia de P8.
  advisory         Boolean            @default(false)
  outOfScopeReason String?            @map("out_of_scope_reason")
  title            String
  rationale        String
  guidance         String?

  /// Impacto ESTIMADO por tipo, nunca somados (§9.7):
  /// [{ type, estimatedBase, horizonDays, confidence }]. O realizado NÃO mora
  /// aqui — é lido de RecommendationOutcome por join. Duas casas para o mesmo
  /// número divergem em silêncio, e a que erra é sempre a projeção.
  impacts Json

  /// Qual dos tipos o outcome vai medir, declarado na geração por regra fixa do
  /// kind (D15). Sem isso, uma recomendação entra várias vezes no denominador.
  primaryImpactType OutcomeDeltaKind @map("primary_impact_type")

  currency     String
  baseCurrency String @map("base_currency")

  priority       RecommendationPriority @default(MEDIUM)
  status         RecommendationStatus   @default(NEW)
  blockedReason  String?                @map("blocked_reason")
  conflictWithId String?                @map("conflict_with_id")

  engineVersion String    @map("engine_version")
  evidence      Json?
  evidenceAsOf  DateTime  @map("evidence_as_of")
  expiresAt     DateTime? @map("expires_at")
  aiNarrative   String?   @map("ai_narrative")

  supersededById String?          @map("superseded_by_id")
  supersededBy   Recommendation?  @relation("RecoLineage", fields: [supersededById], references: [id])
  supersedes     Recommendation[] @relation("RecoLineage")

  appliedAt     DateTime? @map("applied_at")
  dismissedAt   DateTime? @map("dismissed_at")
  dismissReason String?   @map("dismiss_reason")

  ad         Ad                        @relation(fields: [adId], references: [id], onDelete: Cascade)
  wasteItems RecommendationWasteItem[]
  actions    AdAction[]
  outcome    RecommendationOutcome?

  @@index([organizationId, status, priority])
  @@index([adId, status])
  @@map("recommendations")
}

enum RecommendationStatus {
  NEW
  ACKNOWLEDGED
  APPLYING
  APPLIED
  FAILED
  DISMISSED
  EXPIRED
  SUPERSEDED
  DEFERRED_BY_CONFLICT
}

enum RecommendationKind {
  PAUSE_UNDERPERFORMING_AD
  REFRESH_FATIGUED_CREATIVE
  IMPROVE_WEAK_HOOK
  REPLACE_CTA
  MITIGATE_NEGATIVE_FEEDBACK
  REDUCE_BUDGET_HIGH_CPA
  STABILIZE_LEARNING
  CONSOLIDATE_OVERLAP
  EXPAND_AUDIENCE
  SCALE_WINNING_AD
}

/// N:N — um plano coerente responde a vários sinais do mesmo anúncio, e
/// aplicá-lo resolve todos (§9.4).
model RecommendationWasteItem {
  recommendationId String @map("recommendation_id")
  wasteItemId      String @map("waste_item_id")

  recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  wasteItem      WasteItem      @relation(fields: [wasteItemId], references: [id], onDelete: Cascade)

  @@id([recommendationId, wasteItemId])
  @@map("recommendation_waste_items")
}

model RecommendationSuppression {
  id                 String             @id @default(uuid())
  organizationId     String             @map("organization_id")
  kind               RecommendationKind
  scope              SuppressionScope
  scopeId            String?            @map("scope_id")
  reason             String
  createdByAccountId String             @map("created_by_account_id")
  createdAt          DateTime           @default(now()) @map("created_at")
  /// null = permanente.
  expiresAt          DateTime?          @map("expires_at")

  @@index([organizationId, kind, scope, scopeId])
  @@map("recommendation_suppressions")
}

enum SuppressionScope {
  AD
  AD_SET
  CAMPAIGN
  ORGANIZATION
}

/// P8 — o fato que fecha o ciclo. Sem esta tabela, LEARN não existe.
model RecommendationOutcome {
  id               String @id @default(uuid())
  recommendationId String @unique @map("recommendation_id")
  adId             String @map("ad_id")
  /// Segue a LINHAGEM, não o ad_id: recriar o anúncio não pode ler "gasto foi a
  /// zero" como sucesso absoluto quando o gasto só mudou de id.
  lineageId        String @map("lineage_id")
  organizationId   String @map("organization_id")

  /// A linha nasce em APPLY com o PRÉ preenchido e é completada dias depois.
  status OutcomeStatus @default(PENDING_MEASUREMENT)

  appliedAt  DateTime  @map("applied_at")
  windowDays Int       @map("window_days")
  measuredAt DateTime? @map("measured_at")

  currency     String
  baseCurrency String  @map("base_currency")
  /// M4: as duas janelas convertidas pela MESMA taxa, a de appliedAt — senão a
  /// variação cambial vira "efeito da recomendação" no dataset de P8.
  fxRateFixed  Decimal @map("fx_rate_fixed") @db.Decimal(18, 8)

  /// PRÉ: capturado na MESMA TRANSAÇÃO que grava appliedAt (§9.5). Reconstruí-lo
  /// dias depois lê dado já re-declarado e contamina P8 na origem.
  preSpendBase   Decimal @map("pre_spend_base") @db.Decimal(14, 4)
  preRevenueBase Decimal @map("pre_revenue_base") @db.Decimal(14, 4)
  preConversions Int     @map("pre_conversions")
  preAiScore     Float?  @map("pre_ai_score")

  /// PÓS: nulos até a medição. Se fossem NOT NULL, a linha não poderia existir
  /// antes dela — e a captura do pré no apply seria impossível de implementar.
  postSpendBase   Decimal? @map("post_spend_base") @db.Decimal(14, 4)
  postRevenueBase Decimal? @map("post_revenue_base") @db.Decimal(14, 4)
  postConversions Int?     @map("post_conversions")
  postAiScore     Float?   @map("post_ai_score")

  observedDelta     Decimal?          @map("observed_delta") @db.Decimal(14, 4)
  observedDeltaKind OutcomeDeltaKind? @map("observed_delta_kind")
  /// Contexto, fora das métricas de acurácia de P8.
  secondaryDeltas   Json?             @map("secondary_deltas")
  verdict           OutcomeVerdict?
  confidence        Float?
  confounders       Json?

  engineVersion      String  @map("engine_version")
  /// A TERCEIRA coisa versionada do sistema, ao lado de algoVersion e
  /// detectorVersion: em 90 dias a lógica de medição muda pelo menos uma vez, e
  /// sem a versão o número que autoriza automação vira média de duas medidas.
  measurementVersion String? @map("measurement_version")

  recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  @@index([organizationId, verdict, measuredAt])
  @@index([organizationId, status])
  @@index([lineageId])
  @@map("recommendation_outcomes")
}

enum OutcomeStatus {
  PENDING_MEASUREMENT
  MEASURED
  ABANDONED
}

enum OutcomeDeltaKind {
  SPEND_AVOIDED
  REVENUE_DELTA
  SCORE_DELTA
  CPA_DELTA
}

enum OutcomeVerdict {
  IMPROVED
  UNCHANGED
  WORSENED
  INCONCLUSIVE
}

// ─── Ações, execução e consentimento (§4.6) ───────────────────────────────────

model AdAction {
  id               String  @id @default(uuid())
  adId             String  @map("ad_id")
  organizationId   String  @map("organization_id")
  /// Obrigatório quando origin = RECOMMENDATION (P3).
  recommendationId String? @map("recommendation_id")

  origin AdActionOrigin
  type   AdActionType
  level  ActionLevel    @default(AD)

  /// Validado por schema por tipo. Valores monetários SEMPRE na moeda da conta
  /// (M3): enviar a base moveria dinheiro real na quantia errada.
  parameters Json

  /// Sustenta a I2 generalizada: a exclusão é por ALVO, não por anúncio — dois
  /// ads do mesmo conjunto competem pela mesma entidade.
  targetEntityType String @map("target_entity_type")
  targetEntityId   String @map("target_entity_id")

  previousState      Json?      @map("previous_state")
  reversible         Boolean    @default(false)
  revertedByActionId String?    @map("reverted_by_action_id")
  revertedBy         AdAction?  @relation("ActionRevert", fields: [revertedByActionId], references: [id])
  reverts            AdAction[] @relation("ActionRevert")

  scopeWarning String?  @map("scope_warning")
  createdAt    DateTime @default(now()) @map("created_at")

  ad             Ad                @relation(fields: [adId], references: [id], onDelete: Cascade)
  recommendation Recommendation?   @relation(fields: [recommendationId], references: [id])
  executions     ActionExecution[]

  @@index([adId, type])
  @@index([organizationId, origin])
  @@map("ad_actions")
}

enum AdActionOrigin {
  RECOMMENDATION
  WASTE_RESOLUTION
  USER_DIRECT
  REVERT
  AUTOMATION_RULE
}

enum ActionLevel {
  AD
  AD_SET
  CAMPAIGN
}

enum AdActionType {
  PAUSE_AD
  ENABLE_AD
  ARCHIVE_AD
  DUPLICATE_AD
  REPLACE_CREATIVE
  REPLACE_COPY
  REPLACE_CTA
  PAUSE_AD_SET
  ENABLE_AD_SET
  ADJUST_AD_SET_BUDGET
  PAUSE_CAMPAIGN
  ENABLE_CAMPAIGN
  ADJUST_CAMPAIGN_BUDGET
}

model ActionExecution {
  id             String @id @default(uuid())
  actionId       String @map("action_id")
  organizationId String @map("organization_id")

  targetEntityType String @map("target_entity_type")
  targetEntityId   String @map("target_entity_id")

  status  ExecutionStatus @default(QUEUED)
  attempt Int             @default(1)

  /// Única POR ORGANIZAÇÃO (A8): chave global faria duas organizações colidirem,
  /// e a segunda receberia o resultado da ação da primeira.
  idempotencyKey String @map("idempotency_key")
  /// Mesma chave com payload diferente é erro do cliente, não replay: devolver
  /// "o original" seria devolver o resultado de OUTRA ação.
  requestDigest  String @map("request_digest")

  dryRun          Boolean @default(false) @map("dry_run")
  validationDepth String? @map("validation_depth")

  /// Relógio da EXECUÇÃO (enfileirar → plataforma responder), nunca o da
  /// verificação: dimensioná-lo pela escada faria o reaper nunca disparar.
  expiresAt DateTime @map("expires_at")

  /// Quando o pedido entrou. É a âncora do teto diário de C10 — `startedAt` não
  /// serve, porque uma execução ainda em fila não tem começo e não contaria
  /// contra o teto que ela já está consumindo.
  createdAt DateTime @default(now()) @map("created_at")

  requestedByAccountId String  @map("requested_by_account_id")
  correlationId        String? @map("correlation_id")
  requestPayload       Json?   @map("request_payload")
  responsePayload      Json?   @map("response_payload")
  errorCode            String? @map("error_code")
  errorMessage         String? @map("error_message")

  /// Liga o ad recriado à execução que o originou — é o que impede o outcome de
  /// medir o anúncio antigo depois de um REPLACE que recria.
  resultPlatformEntityId String? @map("result_platform_entity_id")

  startedAt           DateTime?           @map("started_at")
  completedAt         DateTime?           @map("completed_at")
  verificationAttempt Int                 @default(0) @map("verification_attempt")
  verifiedAt          DateTime?           @map("verified_at")
  verificationResult  VerificationResult? @map("verification_result")

  action             AdAction    @relation(fields: [actionId], references: [id], onDelete: Cascade)
  resolvedWasteItems WasteItem[] @relation("WasteResolution")

  @@unique([organizationId, idempotencyKey])
  @@index([actionId, status])
  @@index([organizationId, status])
  @@index([organizationId, startedAt])
  /// O teto diário conta por `(organização, dia)` a cada escrita; sem índice, a
  /// contagem varre toda a trilha de auditoria da organização — que é a tabela
  /// que mais cresce e nunca é purgada (§14.6, retenção plena).
  @@index([organizationId, createdAt])
  @@index([resultPlatformEntityId])
  @@map("action_executions")
}

enum ExecutionStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  REJECTED_BY_PLATFORM
  UNSUPPORTED
  CANCELLED
  /// A plataforma criou a entidade e a sequência não terminou (ex.: cópia criada
  /// e pausa não confirmada). Terminal e nunca repetível: repetir criaria outra.
  PARTIALLY_COMPLETED
}

enum VerificationResult {
  CONFIRMED
  DIVERGED
  INCONCLUSIVE

  /// Terminal de §13.4: a escada esgotou sem resposta. Distinto de DIVERGED,
